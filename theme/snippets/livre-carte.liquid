{% comment %}
  Un livre en vignette : sa couverture, son titre et son prix (ou « À paraître »).
  Partagé par le catalogue et la recherche.
  - livre : le produit
  - mention : texte optionnel avant le prix (ex. « Livre 2 »)
  - surligner : les mots cherchés, soulignés dans le titre (recherche)
  Usage : {% render 'livre-carte', livre: tome, mention: 'Livre 2' %}
{% endcomment %}
<a class="livre-carte" href="{{ livre.url }}">
  {%- if livre.featured_image -%}
    {%- capture texte_alt %}Couverture : {% render 'livre-titre', livre: livre %}{% endcapture -%}
    {{- livre.featured_image | image_url: width: 600 | image_tag: widths: '240, 360, 480, 600', sizes: '(min-width: 1024px) 220px, 45vw', alt: texte_alt, loading: 'lazy' -}}
  {%- endif -%}
  {%- capture titre %}{% render 'livre-titre', livre: livre %}{% endcapture -%}
  <strong>{% if surligner != blank %}{{ titre | highlight: surligner }}{% else %}{{ titre }}{% endif %}</strong>
  <span>
    {%- if mention != blank %}{{ mention }} · {% endif -%}
    {%- if livre.available %}{{ livre.price | money_without_trailing_zeros }}{% else %}À paraître{% endif -%}
  </span>
</a>

{% stylesheet %}
  .livre-carte {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
  }

  .livre-carte img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 3px;
    box-shadow: 0 18px 36px -12px #000000e6, 0 0 0 1px #ece5d614;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .livre-carte:hover img {
    transform: translateY(-4px);
  }

  .livre-carte strong {
    font-family: var(--titre);
    font-size: 17px;
    line-height: 1.2;
  }

  .livre-carte span {
    margin-top: -8px;
    font-size: 14px;
    color: var(--gris-2);
  }

  /* La grille de vignettes : 2 colonnes sur mobile, 4 sur PC. */
  .livres-grille {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 16px;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1024px) {
    .livres-grille {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 32px;
    }

    .livre-carte strong {
      font-size: 19px;
    }

    .livre-carte span {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .livre-carte img {
      transition: none;
    }
  }
{% endstylesheet %}
