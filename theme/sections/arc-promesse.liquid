{% comment %}
  Page d'un arc et fiche livre — « Pourquoi on ne le lâche pas ». Maquette validée le 22/11/2026
  (docs/maquette-2026-11-19/Bonus-Promesse.html) : un argumentaire aligné à gauche, sans guillemets, pour ne pas
  ressembler au grand avis centré qui suit. À gauche la phrase-promesse, un mot dans la couleur de la saga ;
  à droite les raisons en liste, chacune avec une rune.
  Champs de la saga : promesse (texte), raisons (liste de textes). Rien si la saga n'a pas de promesse.
  Le mot en couleur : celui entouré d'astérisques dans la promesse (« est *vrai*. »), sinon le dernier mot.
{% endcomment %}
{%- comment -%} La saga de la page Arc, ou celle du livre sur une fiche (templates/product.json). {%- endcomment -%}
{%- assign saga = metaobject | default: product.metafields.custom.saga.value -%}
{%- if saga.promesse.value != blank -%}
  {%- liquid
    assign phrase = saga.promesse.value | escape
    if phrase contains '*'
      assign phrase = phrase | replace_first: '*', '<em>' | replace_first: '*', '</em>'
    else
      # Le dernier mot, sans sa ponctuation finale.
      assign mots = phrase | split: ' '
      assign dernier = mots | last
      assign fin = dernier | slice: -1
      assign ponctuation = ''
      if '.!?…' contains fin
        assign ponctuation = fin
        assign taille = dernier.size | minus: 1
        assign dernier = dernier | slice: 0, taille
      endif
      assign debut = ''
      for mot in mots
        if forloop.last
          break
        endif
        assign debut = debut | append: mot | append: ' '
      endfor
      assign phrase = debut | append: '<em>' | append: dernier | append: '</em>' | append: ponctuation
    endif
    assign runes = 'ᛗ,ᚱ,ᛏ,ᚠ,ᛒ,ᛉ' | split: ','
  -%}
  <section class="arc-bloc arc-promesse" style="{% render 'saga-halo', saga: saga %}" data-reveal>
    <div class="arc-bloc__halo" aria-hidden="true"></div>
    <div class="arc-promesse__panneau verre">
      <div class="arc-promesse__gauche">
        <p class="surtitre">{{ section.settings.surtitre }}</p>
        <h2 class="arc-promesse__phrase">{{ phrase }}</h2>
        <div class="arc-promesse__trait" aria-hidden="true"></div>
      </div>
      {%- if saga.raisons.value != blank -%}
        <ul class="arc-promesse__raisons">
          {%- for raison in saga.raisons.value -%}
            {%- assign rang = forloop.index0 | modulo: runes.size -%}
            {%- comment -%} Une raison est un intitulé : sans point final. {%- endcomment -%}
            {%- assign intitule = raison | strip -%}
            {%- assign fin_raison = intitule | slice: -1 -%}
            {%- if fin_raison == '.' %}{% assign taille = intitule.size | minus: 1 %}{% assign intitule = intitule | slice: 0, taille %}{% endif -%}
            <li><span class="arc-promesse__rune" aria-hidden="true">{{ runes[rang] }}</span><span>{{ intitule }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .arc-promesse__panneau {
    position: relative;
    display: grid;
    gap: 36px;
    padding: clamp(28px, 4vw, 56px);
    border-radius: 22px;
    background: linear-gradient(120deg, color-mix(in srgb, var(--teinte, var(--or)) 6%, transparent), transparent 45%), #14161ab3;
    overflow: hidden;
  }

  .arc-promesse__gauche {
    display: grid;
    gap: 18px;
    justify-items: start;
    text-align: left;
  }

  .arc-promesse__gauche .surtitre {
    color: var(--teinte, var(--or));
  }

  .arc-promesse__phrase {
    font-size: clamp(36px, 4.4vw, 60px);
    line-height: 1.02;
    text-align: left;
  }

  .arc-promesse__phrase em {
    font-style: normal;
    color: var(--teinte, var(--or));
  }

  .arc-promesse__trait {
    width: 64px;
    height: 2px;
    background: var(--teinte, var(--or));
  }

  .arc-promesse__raisons {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .arc-promesse__raisons li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    padding-block: 20px;
    border-top: 1px solid #ece5d61a;
    font-family: var(--titre);
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.2;
  }

  .arc-promesse__raisons li:last-child {
    border-bottom: 1px solid #ece5d61a;
  }

  .arc-promesse__rune {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--teinte, var(--or)) 35%, transparent);
    color: var(--teinte, var(--or));
    font-family: var(--texte);
    font-size: 20px;
  }

  @media (min-width: 900px) {
    .arc-promesse__panneau {
      grid-template-columns: 1.25fr 1fr;
      gap: 56px;
      align-items: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Arc — promesse",
  "settings": [
    {
      "type": "paragraph",
      "content": "La phrase et les raisons viennent de la saga (champs promesse et raisons)."
    },
    {
      "type": "text",
      "id": "surtitre",
      "label": "Surtitre",
      "default": "Pourquoi on ne le lâche pas"
    }
  ],
  "presets": [{ "name": "Arc — promesse" }]
}
{% endschema %}
