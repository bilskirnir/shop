{% comment %}
  Premier écran de l'accueil : logo, promesse, fondateur, note, bouton vers les histoires.
{% endcomment %}
{%- liquid
  # Nombre de lecteurs écrit à la française : 10247 → « 10 247 ». On parcourt les chiffres de droite à gauche en glissant une espace fine insécable tous les trois.
  assign lecteurs = ''
  if settings.nombre_lecteurs != blank
    assign chiffres = settings.nombre_lecteurs | append: '' | split: '' | reverse
    for chiffre in chiffres
      assign rang = forloop.index0 | modulo: 3
      if forloop.index0 > 0 and rang == 0
        assign lecteurs = lecteurs | prepend: '&#8239;'
      endif
      assign lecteurs = lecteurs | prepend: chiffre
    endfor
  endif
-%}

<section class="ecran ouverture">
  <div class="ouverture__coeur">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 420 | image_tag: class: 'ouverture__logo', alt: shop.name }}
    {%- else -%}
      <img class="ouverture__logo" src="{{ 'logo-ivoire.svg' | asset_url }}" alt="{{ shop.name }}" width="180" height="180">
    {%- endif -%}

    <h1>{{ section.settings.titre }}</h1>

    {%- if section.settings.sous_titre != blank -%}
      <p class="ouverture__sous-titre">{{ section.settings.sous_titre }}</p>
    {%- endif -%}

    <div class="ouverture__preuves">
      {%- if section.settings.fondateur_nom != blank -%}
        <div class="ouverture__fondateur">
          {%- if section.settings.fondateur_avatar != blank -%}
            {{ section.settings.fondateur_avatar | image_url: width: 72, height: 72, crop: 'center' | image_tag: alt: section.settings.fondateur_nom, width: 36, height: 36 }}
          {%- endif -%}
          <span>
            {{- section.settings.fondateur_intro -}}
            <strong>{{ section.settings.fondateur_nom }}</strong>
          </span>
        </div>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="ouverture__note">
          <span class="ouverture__etoiles" aria-hidden="true">★★★★★</span>
          <span>
            <strong>{{ section.settings.note }}</strong> {{ section.settings.note_source -}}
            {%- if lecteurs != '' %} · <strong>{{ lecteurs }}</strong> lecteurs{% endif -%}
          </span>
        </p>
      {%- endif -%}
    </div>
  </div>

  <div class="ouverture__action">
    {% render 'bouton', libelle: section.settings.libelle_bouton, url: '#histoires', variante: 'or' %}
    <span class="ouverture__indice" aria-hidden="true">
      Défiler
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
    </span>
  </div>

  {%- comment -%} Cible du bouton : posée tout en bas de cet écran, elle amène pile au début de l'écran suivant. {%- endcomment -%}
  <span id="histoires" class="ouverture__fin"></span>
</section>

{% stylesheet %}
  .ouverture {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ouverture__coeur {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
  }

  /* Le logo rapetisse sur les écrans bas pour que tout tienne. */
  .ouverture__logo {
    width: min(180px, 22svh);
    margin-bottom: 18px;
    animation: lueur 5s ease-in-out infinite;
  }

  .ouverture h1 {
    font-size: clamp(42px, 5.5vw, 84px);
    max-width: 900px;
  }

  .ouverture__sous-titre {
    max-width: 620px;
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.45;
    color: var(--gris-1);
    text-wrap: balance;
  }

  .ouverture__preuves {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .ouverture__fondateur {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 18px 5px 5px;
    border-radius: 999px;
    background: #ece5d60d;
    border: 1px solid #ece5d626;
    text-align: left;
  }

  .ouverture__fondateur img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #ece5d659;
  }

  .ouverture__fondateur span {
    display: flex;
    flex-direction: column;
    gap: 1px;
    font-size: 13px;
    line-height: 1.25;
    color: var(--gris-1);
  }

  .ouverture__fondateur strong {
    font-size: 14px;
    color: var(--ivoire);
  }

  .ouverture__note {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--gris-2);
  }

  .ouverture__note strong {
    color: var(--ivoire);
  }

  .ouverture__etoiles {
    color: var(--or);
    letter-spacing: 0.08em;
  }

  .ouverture__action {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 18px;
  }

  /* Sur mobile, le bouton prend toute la largeur et son texte se centre. */
  .ouverture .bouton--or > span:first-child {
    flex: 1;
    padding-left: 42px;
    text-align: center;
    white-space: nowrap;
  }

  .ouverture__indice {
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--gris-1);
    animation: indice 2s ease-in-out infinite;
  }

  @media (max-height: 700px) {
    .ouverture__indice {
      display: none;
    }
  }

  .ouverture__fin {
    position: absolute;
    bottom: 0;
  }

  @media (min-width: 1024px) {
    .ouverture {
      justify-content: center;
      gap: 22px;
      padding-top: 100px;
      padding-bottom: 40px;
    }

    .ouverture__coeur {
      flex: 0 1 auto;
      gap: 22px;
    }

    .ouverture__logo {
      width: 210px;
      margin-bottom: 10px;
    }

    .ouverture__preuves {
      flex-direction: row;
      gap: 22px;
    }

    .ouverture__fondateur img {
      width: 36px;
      height: 36px;
    }

    .ouverture__note {
      font-size: 14px;
    }

    .ouverture__action {
      align-items: center;
      margin-top: 18px;
    }

    .ouverture .bouton--or {
      min-width: 340px;
    }

    .ouverture .bouton--or > span:first-child {
      flex: 0 1 auto;
      padding-left: 0;
    }

    .ouverture__indice {
      position: absolute;
      bottom: 28px;
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ouverture",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Vide : le logo ivoire du thème."
    },
    {
      "type": "text",
      "id": "titre",
      "label": "Titre",
      "default": "Les romans épiques à la française"
    },
    {
      "type": "textarea",
      "id": "sous_titre",
      "label": "Sous-titre",
      "default": "Des héros, des mythes, et des histoires qui se dévorent comme les meilleures séries."
    },
    {
      "type": "header",
      "content": "Fondateur"
    },
    {
      "type": "image_picker",
      "id": "fondateur_avatar",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "fondateur_intro",
      "label": "Petite ligne",
      "default": "Maison d'édition fondée par"
    },
    {
      "type": "text",
      "id": "fondateur_nom",
      "label": "Nom",
      "default": "Gautier Durrieu de Madron"
    },
    {
      "type": "header",
      "content": "Note",
      "info": "Le nombre de lecteurs se règle dans Paramètres du thème › Bilskirnir."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "4,7/5"
    },
    {
      "type": "text",
      "id": "note_source",
      "label": "Source de la note",
      "default": "sur Amazon"
    },
    {
      "type": "header",
      "content": "Bouton"
    },
    {
      "type": "text",
      "id": "libelle_bouton",
      "label": "Texte du bouton",
      "default": "Découvrir nos romans"
    }
  ],
  "presets": [
    {
      "name": "Ouverture"
    }
  ]
}
{% endschema %}
