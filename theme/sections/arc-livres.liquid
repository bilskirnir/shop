{% comment %}
  Page d'un arc — « Les livres de l'arc » en sommaire : une ligne par livre, tout aligné à gauche
  (chiffre romain, couverture, titre, prix ou « À paraître », bouton). Un titre long s'étale sur la largeur.
  Sur la fiche d'un livre, ce livre est mis en évidence (« Vous êtes ici »).
  Seulement pour une saga de plusieurs livres.
{% endcomment %}
{%- comment -%} La saga de la page Arc, ou celle du livre sur une fiche (templates/product.json). {%- endcomment -%}
{%- assign saga = metaobject | default: product.metafields.custom.saga.value -%}
{%- assign tomes = saga.ordre_des_tomes.value -%}
{%- assign romains = 'I,II,III,IV,V,VI,VII,VIII,IX,X,XI,XII' | split: ',' -%}
{%- if tomes.size > 1 -%}
  <section class="arc-bloc arc-livres" style="{% render 'saga-halo', saga: saga %}" data-reveal>
    <div class="arc-livres__tete">
      <p class="surtitre">{{ section.settings.surtitre }}</p>
      <h2>{{ section.settings.titre }}</h2>
    </div>
    <ol class="arc-livres__liste">
      {%- for tome in tomes -%}
        {%- assign courant = false -%}
        {%- if product and tome.id == product.id %}{% assign courant = true %}{% endif -%}
        <li{% if courant %} class="arc-livres__courant"{% endif %}>
          <a href="{{ tome.url }}"{% if courant %} aria-current="page"{% endif %}>
            <span class="arc-livres__numero" aria-hidden="true">{{ romains[forloop.index0] | default: forloop.index }}</span>
            {%- if tome.featured_image -%}
              {{ tome.featured_image | image_url: width: 240 | image_tag: alt: '', width: 120, class: 'arc-livres__couverture', loading: 'lazy' }}
            {%- endif -%}
            <span class="arc-livres__nom">
              <span class="surtitre">Livre {{ forloop.index }}</span>
              <strong>{{ tome.title }}</strong>
            </span>
            <span class="arc-livres__prix">
              {%- if tome.available -%}{{ tome.price | money_without_trailing_zeros }}{%- else -%}À paraître{%- endif -%}
            </span>
            {%- if courant -%}
              <span class="arc-livres__ici">{{ section.settings.libelle_ici }}</span>
            {%- else -%}
              <span class="bouton bouton--contour">{{ section.settings.libelle_bouton }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ol>
  </section>
{%- endif -%}

{% stylesheet %}
  .arc-livres__tete {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
  }

  .arc-livres__tete .surtitre {
    color: var(--teinte, var(--gris-2));
  }

  .arc-livres__tete h2 {
    font-size: clamp(30px, 3vw, 44px);
    line-height: 1.05;
  }

  .arc-livres__liste {
    padding: 0;
    list-style: none;
  }

  .arc-livres__liste li {
    border-top: 1px solid #ece5d61a;
  }

  .arc-livres__liste li:last-child {
    border-bottom: 1px solid #ece5d61a;
  }

  /* Mobile : couverture à gauche, texte, prix et bouton à droite, empilés. */
  .arc-livres__liste a {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    grid-template-areas:
      'couv nom'
      'couv prix'
      'couv bouton';
    align-items: center;
    gap: 6px 18px;
    padding: 22px 0;
    color: var(--ivoire);
    text-decoration: none;
  }

  .arc-livres__numero {
    display: none;
  }

  .arc-livres__couverture {
    grid-area: couv;
    width: 72px;
    height: auto;
    border-radius: 3px;
    box-shadow: 0 18px 36px -12px #000000e6, 0 0 0 1px #ece5d614;
  }

  .arc-livres__nom {
    grid-area: nom;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .arc-livres__nom .surtitre {
    color: var(--gris-2);
  }

  .arc-livres__nom strong {
    font-family: var(--titre);
    font-size: clamp(18px, 1.7vw, 24px);
    line-height: 1.25;
  }

  .arc-livres__prix {
    grid-area: prix;
    font-size: 15px;
    color: var(--gris-1);
  }

  .arc-livres__liste .bouton--contour {
    grid-area: bouton;
    justify-self: start;
    min-height: 44px;
    padding: 0 22px;
    font-size: 14px;
  }

  /* Le livre de la fiche : fond or léger et pastille « Vous êtes ici ». */
  .arc-livres__courant {
    border-radius: 18px;
    background: #d2b06a12;
    outline: 1px solid #d2b06a40;
  }

  .arc-livres__courant a {
    padding-left: 16px;
    padding-right: 16px;
  }

  .arc-livres__ici {
    grid-area: bouton;
    justify-self: start;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--or);
    color: var(--rond);
    font-size: 13px;
    font-weight: 700;
  }

  @media (min-width: 1024px) {
    .arc-livres__courant .arc-livres__numero {
      color: var(--or);
    }

    .arc-livres__tete {
      margin-bottom: 36px;
    }

    .arc-livres__liste a {
      grid-template-columns: 72px 120px minmax(0, 1fr) auto auto;
      grid-template-areas: 'numero couv nom prix bouton';
      gap: 32px;
      padding: 28px 0;
    }

    .arc-livres__numero {
      display: block;
      grid-area: numero;
      font-family: var(--titre);
      font-size: 56px;
      line-height: 1;
      color: color-mix(in srgb, var(--teinte, var(--or)) 45%, transparent);
    }

    .arc-livres__couverture {
      width: 120px;
    }

    .arc-livres__nom .surtitre {
      display: none;
    }

    .arc-livres__prix {
      font-size: 17px;
    }

    .arc-livres__liste a:hover .bouton--contour {
      border-color: var(--or);
      color: var(--or);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Arc — les livres",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Dans l'ordre" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Les livres de l'arc" },
    { "type": "text", "id": "libelle_bouton", "label": "Bouton", "default": "Voir le livre" },
    { "type": "text", "id": "libelle_ici", "label": "Pastille du livre en cours (fiche)", "default": "Vous êtes ici" }
  ],
  "presets": [{ "name": "Arc — les livres" }]
}
{% endschema %}
