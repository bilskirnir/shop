{% comment %}
  La page où le QR code de chaque livre mène : /products/<livre>?view=avis (templates/product.avis.json).
  1. Ton livre : la note en étoiles et quelques mots. 2. Toi : prénom, email, « Prévenez-moi de la suite ».
  3. Merci : le texte prêt à coller sur Amazon (champ produit custom.lien_amazon) et le tome suivant.
  L'avis part par le formulaire de contact de Shopify : il arrive par email à la boutique (Gautier publie
  les meilleurs en métaobjets « avis »). Si la case est cochée, assets/avis-lecteur.js inscrit aussi l'email
  aux sorties (formulaire client) ; le mail de l'avis porte « Recevoir les sorties : oui » au cas où.
  Sans JavaScript, les deux étapes s'affichent l'une sous l'autre et le formulaire marche pareil.
  Maquette validée le 22/11/2026 : https://claude.ai/artifact/3QLB7H8J4YgdjGEtqzKEha
{% endcomment %}
{%- liquid
  assign saga = product.metafields.custom.saga.value
  assign fond = saga.illustration_hero_de_la_saga.value
  assign amazon = product.metafields.custom.lien_amazon.value
  assign tomes = saga.ordre_des_tomes.value

  # Le rang du livre, et le tome qui le suit.
  assign rang = 0
  for tome in tomes
    if rang > 0 and suivant == blank
      assign suivant = tome
    endif
    if tome.id == product.id
      assign rang = forloop.index
    endif
  endfor
-%}

<div class="avis-lecteur" style="{% render 'saga-halo', saga: saga %}">
  {%- if fond != blank -%}
    <div class="avis-lecteur__fond" aria-hidden="true">
      {{- fond | image_url: width: 1600 | image_tag: widths: '800, 1200, 1600', sizes: '100vw', alt: '' -}}
    </div>
  {%- endif -%}
  <div class="avis-lecteur__halo" aria-hidden="true"></div>

  {%- form 'contact', id: 'avis-lecteur', class: 'avis-lecteur__colonne' -%}
    {%- if form.posted_successfully? -%}
      {%- comment -%} 3. Merci. Le prénom et le texte reviennent du navigateur (assets/avis-lecteur.js). {%- endcomment -%}
      <div class="avis-lecteur__etape avis-lecteur__merci" data-merci>
        <h1>Merci<span data-prenom></span>.</h1>
        <p class="avis-lecteur__intro">{{ section.settings.merci }}</p>

        {%- if amazon != blank -%}
          <div class="avis-lecteur__amazon verre">
            <p class="surtitre">Un geste de plus ?</p>
            <h2>Dis-le aussi sur Amazon</h2>
            <p>C'est là que les nouveaux lecteurs découvrent un livre. Ton texte est prêt, il suffit de le coller.</p>
            <blockquote data-texte hidden></blockquote>
            <button class="avis-lecteur__copier" type="button" data-copier hidden>Copier mon avis</button>
            {% render 'bouton', libelle: 'Ouvrir la page Amazon', url: amazon, variante: 'or' %}
          </div>
        {%- endif -%}

        {%- if suivant -%}
          <a class="avis-lecteur__suite" href="{{ suivant.url }}">
            {%- if suivant.featured_image -%}
              {{ suivant.featured_image | image_url: width: 120 | image_tag: alt: '', width: 52, loading: 'lazy' }}
            {%- endif -%}
            <span>
              <span class="surtitre">La suite de l'histoire</span>
              <strong>{% render 'livre-titre', livre: suivant %} →</strong>
            </span>
          </a>
        {%- endif -%}
      </div>
    {%- else -%}
      <input type="hidden" name="contact[Livre]" value="{{ product.title | escape }}">
      {%- comment -%} Sans ça, Shopify revient sur la fiche du livre et oublie ?view=avis : le merci ne s'afficherait pas. {%- endcomment -%}
      <input type="hidden" name="return_to" value="{{ product.url }}?view=avis&contact_posted=true">
      <p class="avis-lecteur__frise" aria-hidden="true"><span></span><span></span><span></span></p>

      {%- comment -%} 1. Ton livre {%- endcomment -%}
      <div class="avis-lecteur__etape" data-etape="1">
        <div class="avis-lecteur__livre">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 160 | image_tag: alt: '', width: 64 }}
          {%- endif -%}
          <span>
            <span class="surtitre">Tu viens de le finir</span>
            <strong>{% render 'livre-titre', livre: product %}</strong>
            {%- if saga %}<span>{{ saga.nom.value }}{% if tomes.size > 1 %} · Livre {{ rang }}{% endif %}</span>{% endif -%}
          </span>
        </div>

        <fieldset class="avis-lecteur__note">
          <legend><h1>Qu'en as-tu pensé ?</h1></legend>
          <div class="avis-lecteur__etoiles" data-etoiles>
            {%- for n in (1..5) -%}
              <label>
                <input type="radio" name="contact[Note]" value="{{ n }} / 5" required>
                <span class="visually-hidden">{{ n }} étoile{% if n > 1 %}s{% endif %}</span>
                <svg width="40" height="40" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.8z"/></svg>
              </label>
            {%- endfor -%}
          </div>
          <p class="avis-lecteur__mot" data-mot aria-live="polite"></p>
        </fieldset>

        <label class="avis-lecteur__label" for="avis-texte">Quelques mots, si tu veux</label>
        <textarea class="avis-lecteur__champ" id="avis-texte" name="contact[body]" rows="4" maxlength="800" placeholder="Un personnage, une scène, ce qui t'a tenu éveillé…"></textarea>

        <button class="bouton bouton--or avis-lecteur__suivant" type="button" data-suivant hidden>
          <span>Suivant</span>
          <span class="bouton__fleche" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </button>
      </div>

      {%- comment -%} 2. Toi {%- endcomment -%}
      <div class="avis-lecteur__etape" data-etape="2">
        <button class="avis-lecteur__retour" type="button" data-retour hidden>← Ton avis</button>
        <h2>Et toi ?</h2>
        <p class="avis-lecteur__intro">Pour que Gautier sache qui lui écrit. Si ton avis est publié, seul ton prénom apparaît.</p>

        {%- if form.errors -%}
          <p class="avis-lecteur__erreur" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}

        <label class="avis-lecteur__label" for="avis-prenom">Ton prénom</label>
        <input class="avis-lecteur__champ" id="avis-prenom" type="text" name="contact[name]" autocomplete="given-name" required>

        <label class="avis-lecteur__label" for="avis-email">Ton email</label>
        <input class="avis-lecteur__champ" id="avis-email" type="email" name="contact[email]" autocomplete="email" placeholder="ton@email.fr" required>

        <label class="avis-lecteur__case verre">
          <input type="checkbox" name="contact[Recevoir les sorties]" value="oui" checked data-inscription>
          <span><strong>Prévenez-moi de la suite</strong>Les nouveaux livres et les dates de dédicace près de chez toi. Rarement, promis.</span>
        </label>

        {% render 'bouton', libelle: 'Envoyer mon avis', variante: 'or' %}
      </div>
    {%- endif -%}
  {%- endform -%}

  {%- comment -%} L'inscription aux sorties, envoyée en douce dans un cadre caché par assets/avis-lecteur.js. {%- endcomment -%}
  {%- form 'customer', id: 'avis-inscription', target: 'avis-cadre', hidden: true -%}
    <input type="hidden" name="contact[tags]" value="newsletter,lecteur">
    <input type="hidden" name="contact[email]" value="">
  {%- endform -%}
  <iframe name="avis-cadre" title="Inscription aux sorties" hidden></iframe>

  <p class="avis-lecteur__aide avis-lecteur__contact">
    Une question, un souci avec ton livre (page abîmée, erreur de commande) ? Écris-nous : <a href="mailto:contact@bilskirnir.fr">contact@bilskirnir.fr</a>
  </p>
</div>

<script src="{{ 'avis-lecteur.js' | asset_url }}" defer></script>

{% stylesheet %}
  .avis-lecteur {
    position: relative;
    min-height: 100svh;
    padding: 96px var(--gouttiere) 72px;
  }

  /* L'illustration de la saga en décor : en haut, atténuée, fondue vers le noir. */
  .avis-lecteur__fond {
    position: fixed;
    inset: 0 0 auto;
    height: 70svh;
    z-index: -2;
    opacity: 0.38;
    -webkit-mask-image: linear-gradient(#000, #0009 45%, transparent);
    mask-image: linear-gradient(#000, #0009 45%, transparent);
    pointer-events: none;
  }

  .avis-lecteur__fond img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .avis-lecteur__halo {
    position: absolute;
    top: -180px;
    left: 50%;
    width: 560px;
    height: 420px;
    translate: -50% 0;
    z-index: -1;
    border-radius: 50%;
    background: var(--halo-fort, #8b6b3a66);
    filter: blur(90px);
    pointer-events: none;
  }

  .avis-lecteur__colonne {
    max-width: 460px;
    margin: 0 auto;
    /* Au retour (#avis-lecteur), le titre ne passe pas sous la barre du haut. */
    scroll-margin-top: 110px;
  }

  .avis-lecteur__etape {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .avis-lecteur__etape[hidden] {
    display: none;
  }

  .avis-lecteur__etape + .avis-lecteur__etape {
    margin-top: 48px;
  }

  .avis-lecteur--etapes .avis-lecteur__etape + .avis-lecteur__etape {
    margin-top: 0;
  }

  .avis-lecteur h1,
  .avis-lecteur h2 {
    font-size: clamp(28px, 8vw, 36px);
    line-height: 1.1;
  }

  /* Le premier titre tient sur une ligne, même sur un petit téléphone. */
  .avis-lecteur__note h1 {
    white-space: nowrap;
  }

  .avis-lecteur__frise {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin-bottom: 8px;
  }

  .avis-lecteur__frise span {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #ece5d633;
    transition: width 0.3s, background-color 0.3s;
  }

  .avis-lecteur__frise[data-etape='1'] span:nth-child(1),
  .avis-lecteur__frise[data-etape='2'] span:nth-child(2),
  .avis-lecteur__frise[data-etape='3'] span:nth-child(3) {
    width: 22px;
  }

  .avis-lecteur__frise[data-etape='1'] span:nth-child(-n+1),
  .avis-lecteur__frise[data-etape='2'] span:nth-child(-n+2),
  .avis-lecteur__frise[data-etape='3'] span {
    background: var(--or);
  }

  .avis-lecteur__frise:not([data-etape]) {
    display: none;
  }

  .avis-lecteur__livre {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .avis-lecteur__livre img {
    width: 64px;
    border-radius: 3px;
    box-shadow: 0 14px 28px -10px #000000e6;
  }

  .avis-lecteur__livre > span {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .avis-lecteur__livre .surtitre,
  .avis-lecteur__amazon .surtitre {
    color: var(--teinte, var(--or));
  }

  .avis-lecteur__livre strong {
    font-family: var(--titre);
    font-weight: 400;
    font-size: 22px;
    line-height: 1.1;
  }

  .avis-lecteur__livre span span:last-child {
    font-size: 13px;
    color: var(--gris-2);
  }

  .avis-lecteur__note {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 8px 0 0;
    padding: 0;
    border: 0;
  }

  .avis-lecteur__note legend {
    padding: 0;
    margin-bottom: 10px;
  }

  .avis-lecteur__etoiles {
    display: flex;
    justify-content: space-between;
    max-width: 320px;
  }

  .avis-lecteur__etoiles label {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    color: var(--or);
    cursor: pointer;
  }

  .avis-lecteur__etoiles input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .avis-lecteur__etoiles svg {
    fill: none;
    transition: fill 0.2s, transform 0.2s;
  }

  .avis-lecteur__etoiles label:has(input:focus-visible) {
    outline: 2px solid var(--or);
    outline-offset: 2px;
    border-radius: 8px;
  }

  /* Les étoiles jusqu'à celle cochée se remplissent. */
  .avis-lecteur__etoiles label:has(~ label input:checked) svg,
  .avis-lecteur__etoiles label:has(input:checked) svg {
    fill: var(--or);
  }

  .avis-lecteur__etoiles label:has(input:checked) svg {
    transform: scale(1.1);
  }

  .avis-lecteur__mot {
    min-height: 20px;
    font-size: 14px;
    color: var(--gris-1);
  }

  .avis-lecteur__label {
    margin-bottom: -10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--gris-1);
  }

  .avis-lecteur__champ {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid #ece5d626;
    border-radius: 16px;
    background: #14161ad9;
    color: var(--ivoire);
    font-size: 16px;
    resize: vertical;
  }

  .avis-lecteur__champ::placeholder {
    color: var(--gris-3);
  }

  .avis-lecteur__champ:focus {
    outline: none;
    border-color: var(--or);
  }

  .avis-lecteur__case {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border-radius: 16px;
    font-size: 15px;
    line-height: 1.4;
    cursor: pointer;
  }

  .avis-lecteur__case input {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--or);
  }

  .avis-lecteur__case span {
    display: flex;
    flex-direction: column;
    color: var(--gris-2);
  }

  .avis-lecteur__case strong {
    color: var(--ivoire);
  }

  .avis-lecteur .bouton--or {
    width: 100%;
  }

  .avis-lecteur__intro {
    font-size: 16px;
    line-height: 1.5;
    color: var(--gris-1);
  }

  .avis-lecteur__aide {
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
    color: var(--gris-2);
  }

  .avis-lecteur__contact {
    max-width: 480px;
    margin: 48px auto 0;
  }

  .avis-lecteur__retour {
    align-self: flex-start;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--gris-2);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .avis-lecteur__erreur {
    color: #f0a58a;
  }

  .avis-lecteur__amazon {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px;
    border-radius: 20px;
  }

  .avis-lecteur__amazon h2 {
    font-size: 22px;
  }

  .avis-lecteur__amazon p:not(.surtitre) {
    font-size: 14px;
    line-height: 1.45;
    color: var(--gris-1);
  }

  .avis-lecteur__amazon blockquote {
    margin: 0;
    padding: 12px 14px;
    border-radius: 12px;
    background: #0b0c0e99;
    font-size: 14px;
    line-height: 1.45;
  }

  .avis-lecteur__copier {
    min-height: 52px;
    border: 1px solid #ece5d659;
    border-radius: 999px;
    background: none;
    color: var(--ivoire);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }

  .avis-lecteur__suite {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }

  .avis-lecteur__suite img {
    width: 52px;
    border-radius: 3px;
    box-shadow: 0 12px 24px -10px #000000e6;
  }

  .avis-lecteur__suite > span {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .avis-lecteur__suite strong {
    font-family: var(--titre);
    font-weight: 400;
    font-size: 19px;
  }

  /* Chaque étape apparaît en montant doucement. */
  .avis-lecteur__etape:not([hidden]) {
    animation: avis-monte 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  @keyframes avis-monte {
    from { transform: translateY(14px); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .avis-lecteur__etape:not([hidden]) {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Avis d'un lecteur",
  "settings": [
    {
      "type": "text",
      "id": "merci",
      "label": "Texte du merci",
      "default": "Gautier lit chaque avis. Le tien l'aide plus que tu ne crois."
    }
  ]
}
{% endschema %}
