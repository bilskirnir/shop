{% comment %}
  Dernier écran de l'accueil : la maison d'édition, le prochain salon, les personnes,
  et à droite l'esprit français (engagements en blocs, lien vers sa page).
  Dessous, « La lettre de la maison » : inscription par le formulaire client natif, tag « newsletter ».
  Le pied de page suit juste dessous et partage l'écran.
{% endcomment %}
<section class="ecran maison" id="maison">
  <div class="maison__braises" aria-hidden="true"></div>

  <div class="maison__grille" data-reveal>
    <div class="maison__gauche">
      <img class="maison__logo" src="{{ 'logo-ivoire.svg' | asset_url }}" alt="" width="90" height="90" loading="lazy">

      {%- if section.settings.surtitre != blank -%}
        <p class="surtitre maison__surtitre">{{ section.settings.surtitre }}</p>
      {%- endif -%}

      <div class="maison__presentation">{{ section.settings.presentation }}</div>

      {%- if section.settings.salon != blank -%}
        {%- capture salon -%}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
          <span>Prochain salon : <strong>{{ section.settings.salon }}</strong>{% if section.settings.salon_lien != blank %} →{% endif %}</span>
        {%- endcapture -%}
        {%- if section.settings.salon_lien != blank -%}
          <a class="maison__salon" href="{{ section.settings.salon_lien }}">{{ salon }}</a>
        {%- else -%}
          <p class="maison__salon">{{ salon }}</p>
        {%- endif -%}
      {%- endif -%}

      {%- assign personnes = section.blocks | where: 'type', 'personne' -%}
      {%- if personnes.size > 0 -%}
        <div class="maison__personnes">
          {%- for block in personnes -%}
            <div class="maison__personne verre" {{ block.shopify_attributes }}>
              {%- if block.settings.photo != blank -%}
                {{ block.settings.photo | image_url: width: 112, height: 112, crop: 'center' | image_tag: alt: block.settings.nom, width: 56, height: 56, loading: 'lazy' }}
              {%- endif -%}
              <span>
                <strong>{{ block.settings.nom }}</strong>
                {{ block.settings.role }}
              </span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- assign engagements = section.blocks | where: 'type', 'engagement' -%}
    {%- if engagements.size > 0 or section.settings.page_valeurs != blank -%}
      <div class="maison__droite">
        <p class="surtitre maison__surtitre">{{ section.settings.esprit_surtitre }}</p>
        <h2 class="maison__esprit-titre">{{ section.settings.esprit_titre }}</h2>

        {%- if engagements.size > 0 -%}
          <ul class="maison__engagements">
            {%- for block in engagements -%}
              <li {{ block.shopify_attributes }}>
                <strong>{{ block.settings.titre }}</strong>
                {{ block.settings.texte }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.page_valeurs != blank -%}
          <a class="maison__valeurs" href="{{ section.settings.page_valeurs.url }}">
            {{- section.settings.libelle_valeurs | default: section.settings.page_valeurs.title }} →</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="maison__lettre verre" data-reveal>
    <div class="maison__lettre-texte">
      <p class="surtitre maison__surtitre">{{ section.settings.surtitre_inscription }}</p>
      <h2 class="maison__lettre-titre">{{ section.settings.titre_inscription }}</h2>
      {%- if section.settings.texte_inscription != blank -%}
        <p>{{ section.settings.texte_inscription }}</p>
      {%- endif -%}
    </div>

    {%- form 'customer', id: 'inscription-sorties', class: 'maison__inscription' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {%- if form.posted_successfully? -%}
        <p class="maison__message" role="status">C'est noté, tu recevras les sorties.</p>
      {%- else -%}
        <div class="maison__ligne">
          <label class="visually-hidden" for="inscription-email">Ton adresse email</label>
          <div class="maison__champ verre">
            <input
              id="inscription-email"
              type="email"
              name="contact[email]"
              placeholder="ton@email.fr"
              autocomplete="email"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="inscription-erreur"{% endif %}
            >
          </div>
          {% render 'bouton', libelle: section.settings.libelle_inscription, variante: 'or' %}
        </div>
        {%- if form.errors -%}
          <p class="maison__message maison__message--erreur" id="inscription-erreur" role="alert">
            {%- if form.errors contains 'email' -%}
              Cette adresse ne semble pas valide, ou elle est déjà inscrite.
            {%- else -%}
              L'inscription n'a pas fonctionné. Réessaie dans un instant.
            {%- endif -%}
          </p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  /* L'écran laisse la place au pied de page dessous (≈ sa hauteur), pour que les deux tiennent ensemble. */
  .maison {
    --pied: 100px;
    min-height: calc(100svh - var(--pied));
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 84px;
    overflow: hidden;
  }

  .maison__braises {
    position: absolute;
    left: -30%;
    right: -30%;
    bottom: -140px;
    height: 440px;
    background: radial-gradient(50% 60% at 50% 100%, #ece5d673, #b8643c26 45%, transparent 70%);
    filter: blur(8px);
    animation: souffle 5s ease-in-out infinite;
    pointer-events: none;
  }

  .maison__grille,
  .maison__gauche,
  .maison__droite {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .maison__grille {
    gap: 22px;
  }

  .maison__logo {
    width: 72px;
    opacity: 0.4;
    margin-bottom: 4px;
  }

  .maison__surtitre {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.24em;
    color: var(--gris-2);
  }

  .maison__presentation {
    font-size: clamp(17px, 1.6vw, 22px);
    line-height: 1.5;
    color: var(--gris-1);
    max-width: 620px;
  }

  .maison__presentation strong {
    color: var(--ivoire);
    font-weight: 600;
  }

  .maison__salon {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: clamp(13px, 1vw, 15px);
    color: var(--gris-2);
    text-decoration: none;
  }

  .maison__salon svg {
    color: var(--or);
  }

  .maison__salon strong {
    color: var(--ivoire);
    font-weight: 600;
  }

  .maison__personnes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .maison__personne {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    border-radius: 16px;
  }

  .maison__personne img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #ece5d640;
  }

  .maison__personne span {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 12px;
    line-height: 1.35;
    color: var(--gris-2);
  }

  .maison__personne strong {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ivoire);
  }

  /* L'esprit français : les engagements de la maison, puis le lien vers sa page. */
  .maison__esprit-titre {
    font-family: var(--titre);
    font-size: clamp(28px, 2.6vw, 38px);
    line-height: 1.05;
    text-wrap: balance;
  }

  .maison__engagements {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .maison__engagements li {
    font-size: 14px;
    line-height: 1.45;
    color: var(--gris-2);
  }

  .maison__engagements strong {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: var(--ivoire);
  }

  .maison__valeurs {
    align-self: flex-start;
    font-weight: 600;
    color: var(--or);
    text-decoration: none;
  }

  /* La lettre de la maison : bandeau d'inscription sous la grille. */
  .maison__lettre {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 28px;
    padding: 22px;
    border-radius: 22px;
  }

  .maison__lettre-texte {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .maison__lettre-titre {
    font-family: var(--titre);
    font-size: clamp(24px, 2.2vw, 30px);
    line-height: 1.05;
    text-wrap: balance;
  }

  .maison__lettre-texte p:last-child {
    font-size: 15px;
    line-height: 1.5;
    color: var(--gris-2);
  }

  .maison__inscription {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .maison__ligne {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .maison__champ {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 0 22px;
    border-radius: 999px;
  }

  .maison__champ input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ivoire);
    font-size: 16px;
    outline: none;
  }

  .maison__champ:focus-within {
    outline: 2px solid var(--or);
    outline-offset: 2px;
  }

  .maison__message {
    font-size: 15px;
    color: var(--gris-1);
  }

  .maison__message--erreur {
    color: #e0a27e;
  }

  @media (min-width: 1024px) {
    .maison {
      --pied: 70px;
      justify-content: center;
      padding: 120px var(--marge-centre) 40px;
    }

    .maison__grille {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: end;
      gap: 80px;
    }

    .maison__gauche,
    .maison__droite {
      gap: 18px;
    }

    .maison__logo {
      width: 90px;
    }

    .maison__surtitre {
      font-size: 12px;
    }

    .maison__personnes {
      gap: 14px;
      margin-top: 8px;
    }

    .maison__personne {
      flex-direction: row;
      align-items: center;
      gap: 14px;
      padding: 18px;
    }

    .maison__personne img {
      width: 56px;
      height: 56px;
    }

    .maison__personne span {
      font-size: 13px;
    }

    .maison__personne strong {
      font-size: 16px;
    }

    .maison__droite {
      padding-left: 40px;
      border-left: 1px solid #d2b06a55;
    }

    .maison__engagements {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px 24px;
    }

    .maison__engagements li {
      font-size: 15px;
    }

    .maison__engagements strong {
      font-size: 16px;
    }

    .maison__lettre {
      flex-direction: row;
      align-items: center;
      gap: 40px;
      margin-top: 40px;
      padding: 26px 30px 26px 36px;
    }

    .maison__lettre-texte {
      flex: 1.1;
    }

    .maison__inscription {
      flex: 1;
    }

    .maison__ligne {
      flex-direction: row;
    }

    .maison__champ {
      flex: 1;
      min-height: 60px;
    }

    .maison__champ input {
      font-size: 17px;
    }
  }
{% endstylesheet %}

