{% comment %}
  Page d'un arc — l'auteur : photo, nom, présentation (métaobjet auteur du premier livre :
  champs nom, avatar, bio, chiffres). Rien de propre à un auteur n'est réglé dans le modèle.
  chiffres : une liste de textes, « 150k abonnés TikTok » → le premier mot en grand, le reste en légende.
{% endcomment %}
{%- assign saga = metaobject -%}
{%- for tome in saga.ordre_des_tomes.value limit: 1 -%}
  {%- for a in tome.metafields.custom.auteur.value limit: 1 -%}
    {%- assign auteur = a -%}
  {%- endfor -%}
{%- endfor -%}
{%- if auteur -%}
  <section class="arc-bloc arc-auteur" style="{% render 'saga-halo', saga: saga %}" data-reveal>
    <div class="arc-auteur__grille verre">
      {%- if auteur.avatar.value != blank -%}
        {{ auteur.avatar.value | image_url: width: 380, height: 380, crop: 'center' | image_tag: alt: auteur.nom.value, width: 190, height: 190, class: 'arc-auteur__photo', loading: 'lazy' }}
      {%- endif -%}
      <div class="arc-auteur__texte">
        <p class="surtitre">{{ section.settings.surtitre }}</p>
        <h2>{{ auteur.nom.value }}</h2>
        {%- if auteur.bio.value != blank -%}
          <p>{{ auteur.bio.value }}</p>
        {%- endif -%}
        {%- if auteur.chiffres.value != blank -%}
          <dl class="arc-auteur__chiffres">
            {%- for chiffre in auteur.chiffres.value -%}
              {%- assign valeur = chiffre | split: ' ' | first -%}
              <div><dt>{{ chiffre | remove_first: valeur | strip }}</dt><dd>{{ valeur }}</dd></div>
            {%- endfor -%}
          </dl>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .arc-auteur__grille {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    max-width: 980px;
    margin: 0 auto;
    padding: 32px 22px;
    border-radius: 24px;
    text-align: center;
  }

  /* Le halo de la saga, large et fondu, depuis le coin du panneau. */
  .arc-auteur__grille::before {
    content: '';
    position: absolute;
    left: -320px;
    top: -320px;
    width: 900px;
    height: 900px;
    background: radial-gradient(closest-side, var(--halo), var(--halo-doux) 45%, transparent 100%);
    filter: blur(40px);
    pointer-events: none;
  }

  .arc-auteur__grille > * {
    position: relative;
  }

  .arc-auteur__photo {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 24px 44px -14px #000;
  }

  .arc-auteur__texte {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .arc-auteur__texte .surtitre {
    color: var(--teinte, var(--gris-2));
  }

  .arc-auteur__texte h2 {
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1.05;
  }

  .arc-auteur__texte > p:not(.surtitre) {
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.6;
    color: var(--gris-1);
  }

  .arc-auteur__chiffres {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 32px;
    margin: 10px 0 0;
    padding-top: 20px;
    border-top: 1px solid #ece5d61a;
    align-self: stretch;
  }

  .arc-auteur__chiffres div {
    display: flex;
    flex-direction: column-reverse;
  }

  .arc-auteur__chiffres dt {
    font-size: 13px;
    color: var(--gris-2);
  }

  .arc-auteur__chiffres dd {
    margin: 0;
    font-family: var(--titre);
    font-size: clamp(28px, 2.6vw, 36px);
    font-weight: 700;
  }

  @media (min-width: 1024px) {
    .arc-auteur__grille {
      flex-direction: row;
      gap: 56px;
      padding: 48px 56px;
      border-radius: 28px;
      text-align: left;
    }

    .arc-auteur__photo {
      flex: 0 0 auto;
      width: 190px;
      height: 190px;
    }

    .arc-auteur__texte {
      align-items: flex-start;
    }

    .arc-auteur__chiffres {
      justify-content: flex-start;
      gap: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Arc — l'auteur",
  "settings": [
    {
      "type": "paragraph",
      "content": "Nom, avatar, bio et chiffres viennent du métaobjet auteur du premier livre."
    },
    {
      "type": "text",
      "id": "surtitre",
      "label": "Surtitre",
      "default": "L'auteur"
    }
  ],
  "presets": [
    {
      "name": "Arc — l'auteur"
    }
  ]
}
{% endschema %}
