{% comment %}
  Page d'un arc — les avis des lecteurs. Un avis porte sur un livre : champ produit custom.avis
  (liste de métaobjets « avis » : titre, texte, auteur, source, verifie). La page réunit ceux de tous les tomes,
  dans l'ordre des tomes. Le premier (le premier avis du Livre 1) s'affiche en grand dans le halo,
  les suivants en petites cartes. Un avis « Vérifié » porte le badge « Avis vérifié ».
  Sur la fiche d'un livre, seulement les avis de ce livre. Rien si aucun n'a d'avis.
{% endcomment %}
{%- comment -%} La saga de la page Arc, ou celle du livre sur une fiche (templates/product.json). {%- endcomment -%}
{%- assign saga = metaobject | default: product.metafields.custom.saga.value -%}
{%- assign nombre = 0 -%}
{%- for tome in saga.ordre_des_tomes.value -%}
  {%- if product and tome.id != product.id %}{% continue %}{% endif -%}
  {%- assign nombre = nombre | plus: tome.metafields.custom.avis.value.size -%}
{%- endfor -%}
{%- assign limite = section.settings.nombre_cartes | plus: 1 -%}
{%- if nombre > limite %}{% assign nombre = limite %}{% endif -%}
{%- if nombre > 0 -%}
  <section class="arc-bloc arc-avis" style="{% render 'saga-halo', saga: saga %}" data-reveal>
    <div class="arc-bloc__halo" aria-hidden="true"></div>
    <div class="arc-tete">
      <p class="surtitre">{{ section.settings.surtitre }}</p>
      {%- comment -%} La note du livre de la fiche, ou celle du Livre 1 sur la page de la saga. {%- endcomment -%}
      {%- assign livre_note = product -%}
      {%- unless product %}{% for tome in saga.ordre_des_tomes.value limit: 1 %}{% assign livre_note = tome %}{% endfor %}{% endunless -%}
      {% render 'note', livre: livre_note %}
    </div>
    {%- assign rang = 0 -%}
    {%- for tome in saga.ordre_des_tomes.value -%}
      {%- if product and tome.id != product.id %}{% continue %}{% endif -%}
      {%- for un_avis in tome.metafields.custom.avis.value -%}
        {%- assign rang = rang | plus: 1 -%}
        {%- if rang > nombre %}{% break %}{% endif -%}
        {%- capture legende -%}
          <figcaption>
            {{- un_avis.auteur.value }}{% if un_avis.source.value != blank %} · {{ un_avis.source.value }}{% endif -%}
            {%- if un_avis.verifie.value %} <span class="arc-avis__verifie"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>{{ section.settings.libelle_verifie }}</span>{% endif -%}
          </figcaption>
        {%- endcapture -%}
        {%- if rang == 1 -%}
          <figure class="arc-avis__grand">
            {%- if un_avis.titre.value != blank %}<p class="arc-avis__titre">{{ un_avis.titre.value }}</p>{% endif %}
            <blockquote>« {{ un_avis.texte.value }} »</blockquote>
            {{ legende }}
          </figure>
          {%- if nombre > 1 %}<div class="arc-avis__cartes">{% endif -%}
        {%- else -%}
          <figure class="arc-avis__carte verre">
            <span class="note__etoiles" aria-hidden="true">★★★★★</span>
            {%- if un_avis.titre.value != blank %}<p class="arc-avis__titre">{{ un_avis.titre.value }}</p>{% endif %}
            <blockquote>« {{ un_avis.texte.value }} »</blockquote>
            {{ legende }}
          </figure>
          {%- if rang == nombre %}</div>{% endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </section>
{%- endif -%}

{% stylesheet %}
  .arc-avis .arc-tete {
    margin-bottom: 28px;
  }

  .arc-avis__grand {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .arc-avis__grand blockquote {
    margin: 0;
    font-family: var(--titre);
    font-weight: 700;
    font-size: clamp(26px, 3vw, 44px);
    line-height: 1.15;
    text-wrap: balance;
  }

  .arc-avis__grand figcaption {
    margin-top: 16px;
    font-size: 14px;
    color: var(--gris-2);
  }

  .arc-avis__verifie {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: 8px;
    padding: 3px 10px 3px 8px;
    border-radius: 999px;
    background: #d2b06a1f;
    border: 1px solid #d2b06a4d;
    font-size: 12px;
    font-weight: 600;
    color: var(--or);
    vertical-align: middle;
  }

  .arc-avis__titre {
    margin-bottom: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--teinte, var(--or));
  }

  .arc-avis__carte .arc-avis__titre {
    margin-bottom: 0;
    font-family: var(--titre);
    font-size: 17px;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ivoire);
  }

  .arc-avis__cartes {
    position: relative;
    display: flex;
    gap: 12px;
    margin: 40px calc(-1 * var(--marge-centre)) 0 0;
    padding-right: var(--marge-centre);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .arc-avis__carte {
    flex: 0 0 min(260px, 75vw);
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 18px 20px;
    border-radius: 16px;
    scroll-snap-align: start;
  }

  .arc-avis__carte blockquote {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    color: var(--gris-1);
  }

  .arc-avis__carte figcaption {
    font-size: 13px;
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .arc-avis__cartes {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin-right: 0;
      padding-right: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Arc — avis",
  "settings": [
    {
      "type": "paragraph",
      "content": "Les avis viennent des livres de la saga (champ produit Avis), dans l'ordre des tomes."
    },
    {
      "type": "text",
      "id": "surtitre",
      "label": "Surtitre",
      "default": "Ils l'ont lu"
    },
    {
      "type": "text",
      "id": "libelle_verifie",
      "label": "Badge des avis vérifiés",
      "default": "Avis vérifié"
    },
    {
      "type": "range",
      "id": "nombre_cartes",
      "label": "Avis en petites cartes",
      "min": 2,
      "max": 9,
      "step": 1,
      "default": 6,
      "info": "En plus du grand avis. Les suivants restent dans Shopify sans s'afficher."
    }
  ],
  "presets": [{ "name": "Arc — avis" }]
}
{% endschema %}
