{% comment %}
  Page d'un arc — les avis des lecteurs. Chaque métaobjet « avis » désigne son livre : champ livre (référence produit),
  plus note (1 à 5, les vraies étoiles de la carte), titre, texte, auteur, source, verifie. Le lien va de l'avis au livre : ajouter un avis = choisir son livre.
  shortcut: shop.metaobjects.avis.values lit les 50 premiers avis de la boutique ; paginer au-delà. La page réunit ceux de tous les tomes,
  dans l'ordre des tomes. L'un d'eux, tiré au hasard parmi les avis courts (144 caractères au plus), s'affiche en grand
  dans le halo, les suivants en petites cartes. Un avis « Vérifié » porte le badge « Avis vérifié ».
  Sur la fiche d'un livre : tous les avis de ce livre, en petites cartes, dans une bande de bord à bord qui défile
  seule et se tire à la souris (script plus bas). Rien si aucun n'a d'avis.
{% endcomment %}
{%- comment -%} La saga de la page Arc, ou celle du livre sur une fiche (templates/product.json). {%- endcomment -%}
{%- liquid
  assign saga = metaobject | default: product.metafields.custom.saga.value
  # Le grand avis de la page Arc est tiré au hasard (script plus bas) parmi les avis courts : ceux qui tiennent
  # sans « Voir plus ». Sans script, ou sans avis court, c'est le premier avis de la page.
  assign court = 144
  assign nombre = 0
  assign grand_defaut = ''
  assign premier = ''
  for tome in saga.ordre_des_tomes.value
    if product and tome.id != product.id
      continue
    endif
    for un_avis in shop.metaobjects.avis.values
      if un_avis.livre.value.id == tome.id
        assign nombre = nombre | plus: 1
        if premier == ''
          assign premier = un_avis.system.handle
        endif
        if grand_defaut == '' and un_avis.texte.value.size <= court
          assign grand_defaut = un_avis.system.handle
        endif
      endif
    endfor
  endfor
  if grand_defaut == ''
    assign grand_defaut = premier
    assign court = 100000
  endif
-%}
{%- if nombre > 0 -%}
  <section class="arc-bloc arc-avis" id="avis" style="{% render 'saga-halo', saga: saga %}" data-reveal>
    <div class="arc-bloc__halo" aria-hidden="true"></div>
    <div class="arc-tete">
      <p class="surtitre">{{ section.settings.surtitre }}</p>
    </div>
    {%- capture grands -%}{%- endcapture -%}
    {%- capture cartes -%}{%- endcapture -%}
    {%- assign rang_carte = 0 -%}
    {%- for tome in saga.ordre_des_tomes.value -%}
      {%- if product and tome.id != product.id %}{% continue %}{% endif -%}
      {%- for un_avis in shop.metaobjects.avis.values -%}
        {%- if un_avis.livre.value.id != tome.id %}{% continue %}{% endif -%}
        {%- assign handle = un_avis.system.handle -%}
        {%- capture legende -%}
          <figcaption>
            {{- un_avis.auteur.value }}{% if un_avis.source.value != blank %} · {{ un_avis.source.value }}{% endif -%}
            {%- if un_avis.verifie.value %} <span class="arc-avis__verifie"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>{{ section.settings.libelle_verifie }}</span>{% endif -%}
          </figcaption>
        {%- endcapture -%}

        {%- if product == blank and un_avis.texte.value.size <= court -%}
          {%- capture grand -%}
            <figure class="arc-avis__grand" data-grand="{{ handle }}"{% if handle != grand_defaut %} hidden{% endif %}>
              {%- if un_avis.titre.value != blank %}<p class="arc-avis__titre">{{ un_avis.titre.value }}</p>{% endif %}
              {% render 'avis-texte', texte: un_avis.texte.value %}
              {{ legende }}
            </figure>
          {%- endcapture -%}
          {%- assign grands = grands | append: grand -%}
        {%- endif -%}

        {%- comment -%} Page Arc : les petites cartes après le grand avis, nombre_cartes au plus (le script recalcule après le tirage). {%- endcomment -%}
        {%- assign cachee = false -%}
        {%- if product == blank -%}
          {%- if handle == grand_defaut -%}
            {%- assign cachee = true -%}
          {%- else -%}
            {%- assign rang_carte = rang_carte | plus: 1 -%}
            {%- if rang_carte > section.settings.nombre_cartes %}{% assign cachee = true %}{% endif -%}
          {%- endif -%}
        {%- endif -%}
        {%- capture carte -%}
          <figure class="arc-avis__carte verre" data-avis="{{ handle }}"{% if cachee %} hidden{% endif %}>
            {%- assign etoiles = un_avis.note.value -%}
            {%- if etoiles -%}
              <span class="note__etoiles" role="img" aria-label="{{ etoiles }} étoiles sur 5">{% for i in (1..5) %}{% if i <= etoiles %}★{% else %}☆{% endif %}{% endfor %}</span>
            {%- endif %}
            {%- if un_avis.titre.value != blank %}<p class="arc-avis__titre">{{ un_avis.titre.value }}</p>{% endif %}
            {% render 'avis-texte', texte: un_avis.texte.value %}
            {{ legende }}
          </figure>
        {%- endcapture -%}
        {%- assign cartes = cartes | append: carte -%}
      {%- endfor -%}
    {%- endfor -%}

    {%- if product -%}
      <div class="arc-avis__defile" data-defile><div class="arc-avis__piste">{{ cartes }}</div></div>
    {%- else -%}
      {{ grands }}
      {%- if nombre > 1 -%}
        <div class="arc-avis__cartes" data-cartes="{{ section.settings.nombre_cartes }}">{{ cartes }}</div>
      {%- endif -%}
    {%- endif -%}
  </section>
{%- endif -%}

{% javascript %}
  // « Voir plus » d'un avis (snippets/avis-texte.liquid) : déplie le texte complet sur place.
  document.addEventListener('click', (e) => {
    const bouton = e.target.closest('.arc-avis__plus');
    if (!bouton) return;
    const ouvert = bouton.getAttribute('aria-expanded') === 'true';
    const citation = bouton.previousElementSibling;
    citation.querySelector('[data-court]').hidden = !ouvert;
    citation.querySelector('[data-long]').hidden = ouvert;
    bouton.setAttribute('aria-expanded', String(!ouvert));
    bouton.textContent = ouvert ? 'Voir plus' : 'Voir moins';
  });

  // Page Arc : un grand avis tiré au hasard à chaque visite parmi les avis courts ; sa carte disparaît,
  // et les petites cartes se recomptent pour en garder nombre_cartes.
  document.querySelectorAll('.arc-avis').forEach((bloc) => {
    const grands = [...bloc.querySelectorAll('[data-grand]')];
    const zone = bloc.querySelector('[data-cartes]');
    if (grands.length < 2) return;
    const choisi = grands[Math.floor(Math.random() * grands.length)];
    grands.forEach((g) => { g.hidden = g !== choisi; });
    if (!zone) return;
    let place = Number(zone.dataset.cartes);
    zone.querySelectorAll('[data-avis]').forEach((carte) => {
      const garder = carte.dataset.avis !== choisi.dataset.grand && place > 0;
      carte.hidden = !garder;
      if (garder) place--;
    });
  });

  // Fiche livre : la bande d'avis défile seule (en boucle si elle dépasse l'écran) et se tire à la souris.
  // Au doigt, le défilement natif prend le relais. Pause au survol, pendant le glisser, et quand on lit (« Voir plus »).
  document.querySelectorAll('[data-defile]').forEach((bande) => {
    const piste = bande.firstElementChild;
    const vitesse = 45; // pixels par seconde
    const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let survol = false, tire = null, avance = 0, precedent = 0, boucle = false;

    // Un second jeu de cartes, caché aux lecteurs d'écran, rend la boucle continue.
    const cartes = [...piste.children];
    if (!calme && piste.scrollWidth > bande.clientWidth) {
      cartes.forEach((carte) => {
        const copie = carte.cloneNode(true);
        copie.setAttribute('aria-hidden', 'true');
        copie.inert = true;
        piste.append(copie);
      });
      boucle = true;
    }
    // Longueur d'un tour : de la première carte à sa copie (la marge de gauche n'en fait pas partie).
    const moitie = () => piste.children[cartes.length].offsetLeft - cartes[0].offsetLeft;

    function tour(temps) {
      const ecart = precedent ? (temps - precedent) / 1000 : 0;
      precedent = temps;
      const lit = bande.querySelector('.arc-avis__plus[aria-expanded="true"]');
      if (boucle && !survol && !tire && !lit) {
        avance += vitesse * Math.min(ecart, 0.1);
        bande.scrollLeft = avance;
      } else {
        avance = bande.scrollLeft;
      }
      if (boucle && bande.scrollLeft >= moitie()) {
        avance -= moitie();
        bande.scrollLeft = avance;
      }
      requestAnimationFrame(tour);
    }
    if (boucle) requestAnimationFrame(tour);

    bande.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') survol = true; });
    bande.addEventListener('pointerleave', () => { survol = false; });
    bande.addEventListener('touchstart', () => { survol = true; }, {passive: true});
    bande.addEventListener('touchend', () => setTimeout(() => { survol = false; }, 1500), {passive: true});

    // Glisser à la souris. Un vrai glisser (plus de 5 px) annule le clic qui suit, pour ne pas ouvrir « Voir plus » par erreur.
    bande.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      tire = {x: e.clientX, depart: bande.scrollLeft, bouge: false};
    });
    window.addEventListener('pointermove', (e) => {
      if (!tire) return;
      const dx = e.clientX - tire.x;
      if (Math.abs(dx) > 5 && !tire.bouge) {
        tire.bouge = true;
        bande.classList.add('est-tiree');
      }
      if (!tire.bouge) return;
      let cible = tire.depart - dx;
      if (boucle) cible = ((cible % moitie()) + moitie()) % moitie();
      bande.scrollLeft = cible;
    });
    window.addEventListener('pointerup', () => {
      if (!tire) return;
      if (tire.bouge) bande.addEventListener('click', (e) => { e.stopPropagation(); e.preventDefault(); }, {capture: true, once: true});
      bande.classList.remove('est-tiree');
      tire = null;
    });
  });
{% endjavascript %}

{% stylesheet %}
  .arc-avis__plus {
    align-self: flex-start;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--teinte, var(--or));
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  /* Le texte complet apparaît en fondu. */
  .arc-avis [data-long]:not([hidden]) {
    animation: avis-deplie 0.4s ease;
  }

  @keyframes avis-deplie {
    from { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .arc-avis [data-long]:not([hidden]) {
      animation: none;
    }
  }

  .arc-avis .arc-tete {
    margin-bottom: 28px;
  }

  .arc-avis__grand {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .arc-avis__grand blockquote {
    margin: 0;
    font-family: var(--titre);
    font-weight: 700;
    font-size: clamp(26px, 3vw, 44px);
    line-height: 1.15;
    text-wrap: balance;
  }

  .arc-avis__grand figcaption {
    margin-top: 16px;
    font-size: 14px;
    color: var(--gris-2);
  }

  /* Auteur et pastille « Avis vérifié » : quand la pastille passe à la ligne, elle reste alignée, avec un écart. */
  .arc-avis figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
  }

  .arc-avis__grand figcaption {
    justify-content: center;
  }

  .arc-avis__verifie {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px 3px 8px;
    border-radius: 999px;
    background: #d2b06a1f;
    border: 1px solid #d2b06a4d;
    font-size: 12px;
    font-weight: 600;
    color: var(--or);
    vertical-align: middle;
  }

  .arc-avis__titre {
    margin-bottom: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--teinte, var(--or));
  }

  .arc-avis__carte .arc-avis__titre {
    margin-bottom: 0;
    font-family: var(--titre);
    font-size: 17px;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ivoire);
  }

  .arc-avis__cartes {
    position: relative;
    display: flex;
    gap: 12px;
    margin: 40px calc(-1 * var(--marge-centre)) 0 0;
    padding-right: var(--marge-centre);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .arc-avis__carte {
    flex: 0 0 min(260px, 75vw);
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 18px 20px;
    border-radius: 16px;
    scroll-snap-align: start;
  }

  /* Les cartes sont en flex : sans ça, l'attribut hidden (grand avis tiré, cartes en trop) ne les cacherait pas. */
  .arc-avis__carte[hidden] {
    display: none;
  }

  .arc-avis__carte blockquote {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    color: var(--gris-1);
  }

  .arc-avis__carte figcaption {
    font-size: 13px;
    font-weight: 600;
  }

  /* Fiche livre : bande de bord à bord. Le texte sélectionnable gênerait le glisser. */
  .arc-avis__defile {
    /* Bord à bord : la marge négative se règle sur l'écran (100vw), pas sur la colonne du bloc. */
    margin-inline: calc(50% - 50vw);
    padding-block: 8px 16px;
    overflow-x: auto;
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .arc-avis__defile::-webkit-scrollbar {
    display: none;
  }

  .arc-avis__defile.est-tiree {
    cursor: grabbing;
  }

  .arc-avis__piste {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    width: max-content;
  }

  .arc-avis__defile .arc-avis__carte {
    flex: 0 0 min(320px, 78vw);
  }

  @media (min-width: 1024px) {
    .arc-avis__cartes {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin-right: 0;
      padding-right: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Arc — avis",
  "settings": [
    {
      "type": "paragraph",
      "content": "Les avis viennent des livres de la saga (champ produit Avis), dans l'ordre des tomes."
    },
    {
      "type": "text",
      "id": "surtitre",
      "label": "Surtitre",
      "default": "Ils l'ont lu"
    },
    {
      "type": "text",
      "id": "libelle_verifie",
      "label": "Badge des avis vérifiés",
      "default": "Avis vérifié"
    },
    {
      "type": "range",
      "id": "nombre_cartes",
      "label": "Avis en petites cartes",
      "min": 2,
      "max": 9,
      "step": 1,
      "default": 6,
      "info": "En plus du grand avis. Les suivants restent dans Shopify sans s'afficher."
    }
  ],
  "presets": [{ "name": "Arc — avis" }]
}
{% endschema %}
