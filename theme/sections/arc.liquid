{% comment %}
  La page d'un arc : la page web du métaobjet « saga » (modèle templates/metaobject/saga.json).
  Tout vient de la saga, comme sur l'accueil : rien à régler deux fois.

  1. En-tête : couvertures en éventail, surtitre, titre, synopsis, auteur, note, pastilles.
  2. Achat : l'arc complet (tous les tomes au panier en un envoi) si tous sont en vente,
     sinon le premier livre seul.
  3. Les livres, dans l'ordre.
  4. Les autres sagas du même univers.
{% endcomment %}
{%- liquid
  assign saga = metaobject
  assign tomes = saga.ordre_des_tomes.value
  assign nombre = tomes.size | default: 0

  # La liste des tomes se parcourt mais ne s'indexe pas : premier, deuxième, total et disponibilité en une boucle.
  assign total = 0
  assign tout_en_vente = true
  for tome in tomes
    if forloop.index == 1
      assign tome_1 = tome
    elsif forloop.index == 2
      assign tome_2 = tome
    endif
    assign total = total | plus: tome.price
    unless tome.available
      assign tout_en_vente = false
    endunless
  endfor
  assign offre_arc = false
  if nombre > 1 and tout_en_vente
    assign offre_arc = true
  endif
-%}
{%- capture surtitre %}{% render 'saga-surtitre', saga: saga %}{% endcapture -%}
{%- capture noms_auteurs %}{% render 'saga-auteurs', saga: saga %}{% endcapture -%}

<div class="arc" style="{% render 'saga-halo', saga: saga %}">
  <section class="arc__entete">
    <div class="arc__couvertures">
      <div class="arc__halo" aria-hidden="true"></div>
      {%- if tome_2 -%}
        {% render 'couverture', produit: tome_1, taille: 'eventail', position: 1 %}
        {% render 'couverture', produit: tome_2, taille: 'eventail', position: 2 %}
      {%- elsif tome_1 -%}
        {% render 'couverture', produit: tome_1, taille: 'seule' %}
      {%- endif -%}
    </div>

    <div class="arc__texte" data-reveal>
      {%- if surtitre != blank -%}
        <p class="surtitre arc__surtitre">{{ surtitre }}</p>
      {%- endif -%}
      <h1>{{ saga.nom.value }}</h1>
      {%- if saga.synopsis != blank -%}
        <div class="arc__synopsis">{{ saga.synopsis | metafield_tag }}</div>
      {%- endif -%}

      <div class="arc__preuves">
        {%- if noms_auteurs != blank -%}
          <p class="arc__auteur">
            {%- for auteur in tome_1.metafields.custom.auteur.value limit: 1 -%}
              {%- comment -%} Photo de l'auteur : champ « photo » du métaobjet auteur, s'il existe. {%- endcomment -%}
              {%- if auteur.photo.value != blank -%}
                {{ auteur.photo.value | image_url: width: 68, height: 68, crop: 'center' | image_tag: alt: '', width: 34, height: 34 }}
              {%- endif -%}
            {%- endfor -%}
            <span>Écrit par <strong>{{ noms_auteurs }}</strong></span>
          </p>
        {%- endif -%}
        {% render 'note' %}
      </div>

      {% render 'pastilles', liste: saga.tags.value %}

      {%- if tome_1 -%}
        <div class="arc__achat verre">
          {%- if offre_arc -%}
            <div class="arc__offre">
              <p class="arc__prix">{{ total | money_without_trailing_zeros }}</p>
              {%- if section.settings.offre != blank -%}
                <p>{{ section.settings.offre }}</p>
              {%- endif -%}
            </div>
            <form action="{{ routes.cart_add_url }}" method="post" class="arc__formulaire">
              {%- for tome in tomes -%}
                <input type="hidden" name="items[{{ forloop.index0 }}][id]" value="{{ tome.selected_or_first_available_variant.id }}">
                <input type="hidden" name="items[{{ forloop.index0 }}][quantity]" value="1">
              {%- endfor -%}
              {% render 'bouton', libelle: section.settings.libelle_arc, variante: 'or' %}
            </form>
            <a class="arc__livre-seul" href="{{ tome_1.url }}">ou Livre 1 · {{ tome_1.price | money_without_trailing_zeros }}</a>
          {%- else -%}
            <div class="arc__offre">
              <p class="arc__prix">{{ tome_1.price | money_without_trailing_zeros }}</p>
              <p>{{ tome_1.title }}</p>
            </div>
            {% render 'bouton', libelle: section.settings.libelle_livre_1, url: tome_1.url, variante: 'or' %}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- if nombre > 1 -%}
    <section class="arc__livres" data-reveal>
      <h2>{{ section.settings.titre_livres }}</h2>
      <ol>
        {%- for tome in tomes -%}
          <li>
            <a class="arc__livre verre" href="{{ tome.url }}">
              {%- if tome.featured_image -%}
                {{ tome.featured_image | image_url: width: 160 | image_tag: alt: '', width: 72, loading: 'lazy' }}
              {%- endif -%}
              <span class="arc__livre-nom">
                <span class="surtitre">Livre {{ forloop.index }}</span>
                <strong>{{ tome.title }}</strong>
              </span>
              <span class="arc__livre-prix">
                {%- if tome.available -%}
                  {{ tome.price | money_without_trailing_zeros }}
                {%- else -%}
                  À paraître
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ol>
    </section>
  {%- endif -%}

  {%- capture voisines -%}
    {%- for autre in shop.metaobjects.saga.values -%}
      {%- if autre.univers_parent.value.id == saga.univers_parent.value.id and autre.system.id != saga.system.id -%}
        <li>
          <a class="arc__voisine" href="{% render 'saga-lien', saga: autre %}">
            {%- for tome in autre.ordre_des_tomes.value limit: 1 -%}
              {%- if tome.featured_image -%}
                {{ tome.featured_image | image_url: width: 240 | image_tag: alt: '', width: 120, loading: 'lazy' }}
              {%- endif -%}
            {%- endfor -%}
            <span>
              <strong>{{ autre.nom.value }}</strong>
              {% render 'saga-surtitre', saga: autre %}
            </span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if voisines != blank -%}
    <section class="arc__univers" data-reveal>
      <h2>{{ section.settings.titre_univers }}</h2>
      <ul>{{ voisines }}</ul>
    </section>
  {%- endif -%}
</div>

{% stylesheet %}
  .arc {
    padding: 96px var(--marge-centre) 40px;
  }

  .arc h2 {
    font-size: clamp(26px, 2.4vw, 34px);
  }

  /* ---------- En-tête ---------- */
  .arc__entete {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 56px;
  }

  .arc__couvertures {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 300px;
  }

  .arc__halo {
    position: absolute;
    inset: -20%;
    background: radial-gradient(closest-side, var(--halo-fort), var(--halo-doux) 45%, transparent 75%);
    pointer-events: none;
  }

  .arc__texte {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .arc__surtitre {
    color: var(--teinte, var(--gris-1));
  }

  .arc h1 {
    font-size: clamp(40px, 5vw, 72px);
    line-height: 0.95;
    text-wrap: balance;
  }

  .arc__synopsis {
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.6;
    color: var(--gris-1);
  }

  .arc__preuves {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
  }

  .arc__auteur {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 18px 5px 5px;
    border-radius: 999px;
    background: #ece5d60d;
    border: 1px solid #ece5d626;
    font-size: 13px;
    color: var(--gris-1);
  }

  .arc__auteur img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
  }

  .arc__auteur:not(:has(img)) {
    padding-left: 16px;
  }

  .arc__auteur strong {
    color: var(--ivoire);
  }

  /* ---------- Achat ---------- */
  .arc__achat {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 6px;
    padding: 20px;
    border-radius: 24px;
  }

  .arc__offre {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
    color: var(--gris-1);
  }

  .arc__prix {
    font-family: var(--titre);
    font-size: 34px;
    font-weight: 700;
    line-height: 1;
    color: var(--ivoire);
  }

  .arc__formulaire,
  .arc__achat > .bouton {
    display: flex;
  }

  .arc__formulaire .bouton,
  .arc__achat > .bouton {
    flex: 1;
  }

  .arc__livre-seul {
    align-self: flex-start;
    font-size: 14px;
    color: var(--gris-1);
    text-underline-offset: 3px;
  }

  /* ---------- Les livres ---------- */
  .arc__livres,
  .arc__univers {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 56px;
  }

  .arc__livres ol,
  .arc__univers ul {
    display: grid;
    gap: 14px;
    padding: 0;
    list-style: none;
  }

  .arc__livre {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 14px 20px 14px 14px;
    border-radius: 18px;
    text-decoration: none;
  }

  .arc__livre img,
  .arc__voisine img {
    border-radius: 3px;
    box-shadow: 0 10px 20px -8px #000000d9;
  }

  .arc__livre img {
    width: 60px;
    height: auto;
  }

  .arc__livre-nom {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .arc__livre-nom .surtitre {
    color: var(--gris-2);
  }

  .arc__livre-nom strong {
    font-family: var(--titre);
    font-size: clamp(19px, 1.7vw, 24px);
    line-height: 1.15;
    color: var(--ivoire);
  }

  .arc__livre-prix {
    font-size: 17px;
    color: var(--gris-1);
    white-space: nowrap;
  }

  /* ---------- Même univers ---------- */
  .arc__voisine {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 14px;
    color: var(--gris-2);
    text-decoration: none;
  }

  .arc__voisine img {
    width: 84px;
    aspect-ratio: 2 / 3;
    height: auto;
    object-fit: cover;
  }

  .arc__voisine span {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .arc__voisine strong {
    font-family: var(--titre);
    font-size: clamp(20px, 1.7vw, 24px);
    line-height: 1.1;
    color: var(--ivoire);
  }

  @media (min-width: 1024px) {
    .arc {
      padding-top: 120px;
    }

    .arc__entete {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      align-items: center;
      gap: 72px;
      padding-bottom: 72px;
    }

    .arc__couvertures {
      min-height: 560px;
    }

    .arc__couvertures .couverture--eventail {
      width: 290px;
    }

    .arc__couvertures .couverture--eventail.couverture--1 {
      margin-right: -70px;
    }

    .arc__couvertures .couverture--eventail.couverture--2 {
      margin-top: 60px;
    }

    .arc__couvertures .couverture--seule {
      width: 320px;
    }

    .arc__texte {
      gap: 18px;
      max-width: 600px;
    }

    .arc__achat {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 16px 24px;
      padding: 22px 22px 22px 26px;
    }

    .arc__livre-seul {
      grid-column: 1 / -1;
    }

    .arc__livres ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .arc__livre {
      gap: 22px;
      padding: 18px 26px 18px 18px;
    }

    .arc__livre img {
      width: 72px;
    }

    .arc__univers ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
    }

    .arc__voisine {
      gap: 20px;
    }

    .arc__voisine img {
      width: 120px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Arc",
  "settings": [
    {
      "type": "paragraph",
      "content": "Tout le contenu vient de la saga (Contenu › Métaobjets › Saga)."
    },
    {
      "type": "text",
      "id": "offre",
      "label": "Offre de l'arc complet",
      "default": "L'arc complet, livraison offerte et un décapsuleur en cadeau."
    },
    {
      "type": "text",
      "id": "libelle_arc",
      "label": "Bouton de l'arc complet",
      "default": "Prendre l'arc complet"
    },
    {
      "type": "text",
      "id": "libelle_livre_1",
      "label": "Bouton si l'arc n'est pas complet",
      "default": "Commencer par le Livre 1"
    },
    {
      "type": "text",
      "id": "titre_livres",
      "label": "Titre de la liste des livres",
      "default": "Les livres, dans l'ordre"
    },
    {
      "type": "text",
      "id": "titre_univers",
      "label": "Titre des autres histoires",
      "default": "Dans le même univers…"
    }
  ]
}
{% endschema %}
