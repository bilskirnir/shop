{% comment %}
  Haut de la page d'un arc (page web du métaobjet « saga », modèle templates/metaobject/saga.json).
  Couvertures en éventail, surtitre, titre, synopsis, auteur, note, pastilles, bloc d'achat
  avec ses garanties sous le bouton (blocs « garantie », « [auteur] » = l'auteur de la saga) ;
  derrière, l'illustration de la saga sous un voile. Une barre d'achat suit le défilement
  une fois ce bloc dépassé (arc.js). Les autres blocs de la page sont les sections arc-*.

  Arc complet (tous les tomes au panier en un envoi) seulement si la saga a plusieurs tomes
  tous en vente ; sinon, le premier livre seul.
{% endcomment %}
{%- liquid
  assign saga = metaobject
  assign tomes = saga.ordre_des_tomes.value
  assign tout_en_vente = true
  for tome in tomes
    if forloop.index == 1
      assign tome_1 = tome
    elsif forloop.index == 2
      assign tome_2 = tome
    endif
    unless tome.available
      assign tout_en_vente = false
    endunless
  endfor
  assign offre_arc = false
  if tomes.size > 1 and tout_en_vente
    assign offre_arc = true
  endif
  assign fond = saga.illustration_hero_de_la_saga.value
-%}
{%- capture surtitre %}{% render 'saga-surtitre', saga: saga %}{% endcapture -%}
{%- capture noms_auteurs %}{% render 'saga-auteurs', saga: saga %}{% endcapture -%}
{%- capture total %}{% render 'arc-total', saga: saga %}{% endcapture -%}

<div class="arc" style="{% render 'saga-halo', saga: saga %}">
  {%- if fond != blank -%}
    <div class="arc__fond" aria-hidden="true">
      {{- fond | image_url: width: 2400 | image_tag: widths: '800, 1200, 1800, 2400', sizes: '100vw', alt: '' -}}
    </div>
  {%- endif -%}

  <section class="arc__entete">
    <div class="arc__couvertures">
      <div class="arc__halo" aria-hidden="true"></div>
      {%- if tome_2 -%}
        {% render 'couverture', produit: tome_1, taille: 'eventail', position: 1 %}
        {% render 'couverture', produit: tome_2, taille: 'eventail', position: 2 %}
      {%- elsif tome_1 -%}
        {% render 'couverture', produit: tome_1, taille: 'seule' %}
      {%- endif -%}
    </div>

    <div class="arc__texte" data-reveal>
      {%- if surtitre != blank -%}
        <p class="surtitre arc__surtitre">{{ surtitre }}</p>
      {%- endif -%}
      <h1>{{ saga.nom.value }}</h1>
      {%- if saga.synopsis != blank -%}
        <div class="arc__synopsis">{{ saga.synopsis | metafield_tag }}</div>
      {%- endif -%}

      <div class="arc__preuves">
        {%- if noms_auteurs != blank -%}
          <p class="arc__auteur">
            {%- for auteur in tome_1.metafields.custom.auteur.value limit: 1 -%}
              {%- comment -%} Photo : champ « avatar » du métaobjet auteur, s'il existe. {%- endcomment -%}
              {%- if auteur.avatar.value != blank -%}
                {{ auteur.avatar.value | image_url: width: 68, height: 68, crop: 'center' | image_tag: alt: '', width: 34, height: 34 }}
              {%- endif -%}
            {%- endfor -%}
            <span>Écrit par <strong>{{ noms_auteurs }}</strong></span>
          </p>
        {%- endif -%}
        {% render 'note' %}
      </div>

      {% render 'pastilles', liste: saga.tags.value %}

      {%- if tome_1 -%}
        <div class="arc__achat verre" id="arc-achat">
          {%- if offre_arc -%}
            <div class="arc__offre">
              <p class="arc__prix">{{ total }}</p>
              {%- if section.settings.offre != blank -%}
                <p>{{ section.settings.offre }}</p>
              {%- endif -%}
            </div>
            {% render 'arc-achat', saga: saga, libelle: section.settings.libelle_arc %}
            <a class="arc__livre-seul" href="{{ tome_1.url }}">ou Livre 1 · {{ tome_1.price | money_without_trailing_zeros }}</a>
          {%- else -%}
            <div class="arc__offre">
              <p class="arc__prix">{{ tome_1.price | money_without_trailing_zeros }}</p>
              <p>{{ tome_1.title }}</p>
            </div>
            {% render 'bouton', libelle: section.settings.libelle_livre_1, url: tome_1.url, variante: 'or' %}
          {%- endif -%}
          {% render 'garanties', blocs: section.blocks, auteur: noms_auteurs %}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- if offre_arc -%}
    <div class="arc__barre verre" aria-hidden="true" inert>
      {%- if tome_1.featured_image -%}
        {{ tome_1.featured_image | image_url: width: 80 | image_tag: alt: '', width: 34, loading: 'lazy' }}
      {%- endif -%}
      <p><strong>{{ saga.nom.value }}</strong>L'arc complet · {{ total }}</p>
      {% render 'arc-achat', saga: saga, libelle: section.settings.libelle_barre %}
    </div>
    <script src="{{ 'arc.js' | asset_url }}" defer></script>
  {%- endif -%}
</div>

{% stylesheet %}
  .arc {
    position: relative;
    padding: 124px var(--marge-centre) 0;
  }

  /* L'illustration de la saga, fixe au fond de toute la page, sous un voile (même plan que sur l'accueil). */
  .arc__fond {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
  }

  .arc__fond img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .arc__fond::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #0b0c0ea6;
  }

  .arc__entete {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .arc__couvertures {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 300px;
  }

  .arc__halo {
    position: absolute;
    inset: -20%;
    background: radial-gradient(closest-side, var(--halo-fort), var(--halo-doux) 45%, transparent 75%);
    pointer-events: none;
  }

  .arc__texte {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .arc__surtitre {
    color: var(--teinte, var(--gris-1));
  }

  .arc h1 {
    font-size: clamp(40px, 5vw, 72px);
    line-height: 0.95;
    text-wrap: balance;
  }

  .arc__synopsis {
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.6;
    color: var(--gris-1);
  }

  .arc__preuves {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
  }

  .arc__auteur {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 18px 5px 5px;
    border-radius: 999px;
    background: #ece5d60d;
    border: 1px solid #ece5d626;
    font-size: 13px;
    color: var(--gris-1);
  }

  .arc__auteur img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
  }

  .arc__auteur:not(:has(img)) {
    padding-left: 16px;
  }

  .arc__auteur strong {
    color: var(--ivoire);
  }

  .arc__achat {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 6px;
    padding: 20px;
    border-radius: 24px;
  }

  .arc__offre {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
    color: var(--gris-1);
  }

  .arc__prix {
    font-family: var(--titre);
    font-size: 34px;
    font-weight: 700;
    line-height: 1;
    color: var(--ivoire);
  }

  .arc-achat {
    display: flex;
  }

  .arc-achat .bouton,
  .arc__achat > .bouton {
    flex: 1;
  }

  .arc__livre-seul {
    align-self: flex-start;
    font-size: 14px;
    color: var(--gris-1);
    text-underline-offset: 3px;
  }

  /* Barre d'achat : cachée tant que le bloc d'achat est à l'écran (arc.js pose .visible). */
  .arc__barre {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 8;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 16px;
    border-radius: 999px;
    box-shadow: 0 16px 32px -12px #000;
    opacity: 0;
    transform: translateY(24px);
    pointer-events: none;
    transition: opacity 0.35s, transform 0.35s;
  }

  .arc__barre.visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .arc__barre img {
    display: none;
    width: 34px;
    border-radius: 2px;
  }

  .arc__barre p {
    flex: 1;
    display: flex;
    flex-direction: column;
    font-size: 12px;
    line-height: 1.3;
    color: var(--gris-1);
  }

  .arc__barre strong {
    font-size: 14px;
    color: var(--ivoire);
  }

  .arc__barre .bouton--or {
    min-height: 48px;
    gap: 14px;
    padding-left: 18px;
    font-size: 15px;
  }

  .arc__barre .bouton__fleche {
    width: 34px;
    height: 34px;
  }

  @media (min-width: 1024px) {
    .arc {
      padding-top: 180px;
    }

    .arc__entete {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      align-items: center;
      gap: 72px;
    }

    .arc__couvertures {
      min-height: 560px;
    }

    .arc__couvertures .couverture--eventail {
      width: 290px;
    }

    .arc__couvertures .couverture--eventail.couverture--1 {
      margin-right: -70px;
    }

    .arc__couvertures .couverture--eventail.couverture--2 {
      margin-top: 60px;
    }

    .arc__couvertures .couverture--seule {
      width: 320px;
    }

    .arc__texte {
      gap: 18px;
      max-width: 600px;
    }

    .arc__achat {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 16px 24px;
      padding: 22px 22px 22px 26px;
    }

    .arc__livre-seul,
    .arc__achat .garanties {
      grid-column: 1 / -1;
    }

    .arc__barre {
      left: 50%;
      right: auto;
      bottom: 20px;
      gap: 24px;
      padding-left: 12px;
      transform: translate(-50%, 24px);
    }

    .arc__barre.visible {
      transform: translate(-50%, 0);
    }

    .arc__barre img {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Arc — haut",
  "settings": [
    {
      "type": "paragraph",
      "content": "Le contenu vient de la saga (Contenu › Métaobjets › Saga)."
    },
    {
      "type": "text",
      "id": "offre",
      "label": "Offre de l'arc complet",
      "default": "L'arc complet, livraison offerte."
    },
    {
      "type": "text",
      "id": "libelle_arc",
      "label": "Bouton de l'arc complet",
      "default": "Prendre l'arc complet"
    },
    {
      "type": "text",
      "id": "libelle_barre",
      "label": "Bouton de la barre d'achat",
      "default": "Prendre l'arc"
    },
    {
      "type": "text",
      "id": "libelle_livre_1",
      "label": "Bouton si l'arc n'est pas complet",
      "default": "Commencer par le Livre 1"
    }
  ],
  "blocks": [
    {
      "type": "garantie",
      "name": "Garantie",
      "settings": [
        {
          "type": "select",
          "id": "icone",
          "label": "Icône",
          "options": [
            {
              "value": "dedicace",
              "label": "Plume (dédicace)"
            },
            {
              "value": "livraison",
              "label": "Camion (livraison)"
            },
            {
              "value": "france",
              "label": "Drapeau"
            }
          ],
          "default": "dedicace"
        },
        {
          "type": "text",
          "id": "titre",
          "label": "Titre"
        },
        {
          "type": "text",
          "id": "texte",
          "label": "Texte",
          "info": "[auteur] = le nom de l'auteur de la saga."
        }
      ]
    }
  ]
}
{% endschema %}
