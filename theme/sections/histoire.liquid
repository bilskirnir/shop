{% comment %}
  Un écran de l'accueil pour une histoire. Une histoire est toujours une saga (métaobjet « saga »),
  d'un ou de plusieurs livres : Gautier ne règle chaque chose qu'à un seul endroit.

  | Élément         | Source                                                                 |
  | Couvertures     | 2 premiers tomes en éventail ; un seul → en grand                      |
  | Surtitre        | « N livres » (1 livre → type du produit, ex. « Roman ») · mention_de_lecture |
  | Titre, accroche | nom (titre court d'affichage), teaser_court                            |
  | Auteur          | custom.auteur du premier tome                                          |
  | Couleur         | couleur_halo, sinon la couleur de l'univers parent                     |
  | Nouveauté       | la parution la plus récente des tomes                                  |
  | Lien            | 1 livre → sa fiche ; plusieurs → la page de la saga, sinon le 1er tome |

  Un champ vide ne casse rien : l'élément disparaît, la couleur retombe sur un halo ivoire neutre.
{% endcomment %}
{%- liquid
  assign saga = section.settings.saga

  if saga != blank
    assign tomes = saga.ordre_des_tomes.value
    assign nombre = tomes.size | default: 0

    # La liste des tomes se parcourt mais ne s'indexe pas (tomes[0] et tomes.first sont vides) : on prend les deux premiers en boucle.
    for tome in tomes limit: 2
      if forloop.first
        assign tome_1 = tome
      else
        assign tome_2 = tome
      endif
    endfor

    if nombre == 1
      assign libelle = section.settings.libelle_bouton | default: 'Voir le livre'
    else
      assign libelle = section.settings.libelle_bouton | default: "Entrer dans l'arc"
    endif

    assign titre = saga.nom.value
    assign accroche = saga.teaser_court.value

    # La date la plus récente parmi les tomes déjà parus (une date future ne compte pas).
    assign maintenant = 'now' | date: '%s' | plus: 0
    assign date_recente = nil
    assign secondes_recentes = 0
    for tome in tomes
      assign d = tome.metafields.custom.date_parution.value
      if d != blank
        assign s = d | date: '%s' | plus: 0
        if s <= maintenant and s > secondes_recentes
          assign secondes_recentes = s
          assign date_recente = d
        endif
      endif
    endfor
  endif

  # Image de fond : celle choisie dans la section, sinon l'illustration de la saga.
  assign fond = section.settings.image_fond | default: saga.illustration_hero_de_la_saga.value
  assign voile_opacite = section.settings.voile_opacite | divided_by: 100.0
  assign voile = section.settings.voile_couleur | color_modify: 'alpha', voile_opacite

  # Particules : le réglage de la section, sinon le champ style_particules de la saga, sinon aucune.
  assign particules = section.settings.particules
  if particules == 'auto'
    assign particules = saga.style_particules.value | default: 'aucune'
  endif

-%}
{%- capture surtitre %}{% render 'saga-surtitre', saga: saga %}{% endcapture -%}
{%- capture noms_auteurs %}{% render 'saga-auteurs', saga: saga %}{% endcapture -%}
{%- capture lien %}{% render 'saga-lien', saga: saga %}{% endcapture -%}

{%- if titre != blank -%}
  <section
    class="ecran histoire"
    data-nom="{{ titre | escape }}"
    style="{% render 'saga-halo', saga: saga %}"
  >
    {%- if fond != blank -%}
      <div class="histoire__fond fondu" style="--voile: {{ voile }};" aria-hidden="true">
        {{- fond | image_url: width: 2400 | image_tag: widths: '800, 1200, 1800, 2400', sizes: '100vw', alt: '' -}}
      </div>
    {%- endif -%}

    {%- comment -%} Sauf pour les braises, le feu du décor s'éteint pendant cet écran (.eteint-feu, base.css). {%- endcomment -%}
    {%- if particules == 'neige' -%}
      {% render 'neige' %}
    {%- elsif particules != 'braises' -%}
      {%- comment -%} Marqueur sans rendu : hidden le sort de la grille texte | couvertures. {%- endcomment -%}
      <div class="eteint-feu fondu" hidden></div>
    {%- endif -%}

    <div class="histoire__texte" data-reveal>
      {% render 'badge-nouveaute', date: date_recente %}
      {%- if surtitre != blank -%}
        <p class="surtitre histoire__surtitre">{{ surtitre }}</p>
      {%- endif -%}
      <h2>{{ titre }}</h2>
      {%- if noms_auteurs != blank -%}
        <p class="histoire__auteur">par {{ noms_auteurs }}</p>
      {%- endif -%}
      {%- if accroche != blank -%}
        <p class="histoire__accroche">{{ accroche }}</p>
      {%- endif -%}
      {% render 'pastilles', liste: saga.tags.value %}
      {%- if lien != blank -%}
        {% render 'bouton', libelle: libelle, url: lien, variante: 'contour' %}
      {%- endif -%}
    </div>

    <div class="histoire__couvertures">
      <div class="histoire__halo" aria-hidden="true"></div>
      {%- if tome_2 -%}
        {% render 'couverture', produit: tome_1, taille: 'eventail', position: 1 %}
        {% render 'couverture', produit: tome_2, taille: 'eventail', position: 2 %}
      {%- elsif tome_1 -%}
        {% render 'couverture', produit: tome_1, taille: 'seule' %}
      {%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="ecran histoire histoire--vide">
    <p>Choisis une histoire (saga) dans les réglages de cette section.</p>
  </section>
{%- endif -%}

{% stylesheet %}
  .histoire {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 36px;
    padding-top: 64px;
    overflow: hidden;
  }

  /* Le halo est centré sur les couvertures, quelle que soit leur taille. */
  .histoire__halo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 180vw;
    height: 560px;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, var(--halo), transparent 72%);
    pointer-events: none;
  }

  /* Image de fond de l'histoire : plein écran, fixe, entre la forêt et les particules.
     Elle apparaît en fondu (.fondu, base.css) quand son écran passe au milieu de la vue. */
  .histoire__fond {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
  }

  .histoire__fond img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Le voile réglable (couleur + intensité) posé sur l'image. */
  .histoire__fond::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--voile);
  }

  .histoire__couvertures {
    position: relative;
    order: -1;
    display: flex;
    justify-content: center;
  }

  .histoire__texte {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .histoire__surtitre {
    color: var(--teinte, var(--gris-1));
  }

  .histoire h2 {
    font-size: clamp(40px, 5vw, 72px);
  }

  .histoire__auteur {
    margin-top: -4px;
    font-size: clamp(14px, 1.1vw, 16px);
    font-style: italic;
    color: var(--gris-2);
  }

  /* Les tags en pastilles : sur PC seulement, le mobile est déjà plein. */
  .histoire .pastilles {
    display: none;
  }

  .histoire__accroche {
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.45;
    color: var(--gris-1);
  }

  .histoire--vide {
    align-items: center;
    color: var(--gris-2);
  }

  @media (min-width: 1024px) {
    /* Texte et couvertures resserrés au centre (1100 px au plus), au lieu de coller aux bords. */
    .histoire {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
      gap: 164px;
      /* Même marge en haut et en bas : le contenu est centré sur l'écran, la barre fine passe au-dessus. */
      padding: 96px var(--marge-centre);
    }

    .histoire__halo {
      width: 900px;
      height: 900px;
      background: radial-gradient(closest-side, var(--halo-fort), var(--halo-doux) 45%, transparent 75%);
    }

    .histoire__couvertures {
      order: 0;
      align-items: center;
    }

    /* Une paire de couvertures part du début de sa colonne et déborde à droite, dans la marge. */
    .histoire__couvertures:has(.couverture--eventail) {
      justify-content: flex-start;
    }

    .histoire__texte {
      gap: 18px;
      max-width: 640px;
    }

    .histoire__accroche {
      line-height: 1.5;
    }

    .histoire .pastilles {
      display: flex;
    }

    .histoire .bouton {
      margin-top: 8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Histoire",
  "settings": [
    {
      "type": "paragraph",
      "content": "Choisis l'histoire (saga) à présenter, d'un ou de plusieurs livres. Couvertures, textes, couleur et fond viennent de sa fiche."
    },
    {
      "type": "metaobject",
      "id": "saga",
      "label": "Histoire (saga)",
      "metaobject_type": "saga"
    },
    {
      "type": "image_picker",
      "id": "image_fond",
      "label": "Image de fond",
      "info": "Facultative. Apparaît en fondu derrière cet écran, sous les braises. Vide : l'illustration de la saga, sinon le décor habituel."
    },
    {
      "type": "color",
      "id": "voile_couleur",
      "label": "Couleur du voile",
      "info": "Voile posé sur l'image de fond pour l'assombrir ou la teinter.",
      "default": "#0b0c0e"
    },
    {
      "type": "range",
      "id": "voile_opacite",
      "label": "Intensité du voile",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "select",
      "id": "particules",
      "label": "Particules",
      "options": [
        { "value": "auto", "label": "Celles de la fiche (aucune si vide)" },
        { "value": "aucune", "label": "Aucune" },
        { "value": "braises", "label": "Braises qui montent" },
        { "value": "neige", "label": "Neige qui tombe" }
      ],
      "default": "auto"
    },
    {
      "type": "text",
      "id": "libelle_bouton",
      "label": "Texte du bouton",
      "info": "Vide : « Voir le livre » pour une histoire d'un livre, « Entrer dans l'arc » sinon."
    }
  ],
  "presets": [
    {
      "name": "Histoire"
    }
  ]
}
{% endschema %}
