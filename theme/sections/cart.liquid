{% comment %}
  La page /cart : le même contenu que le tiroir (snippets/panier-contenu.liquid), en page centrée.
  Elle sert sans JavaScript, et quand on arrive par un lien direct. Styles : sections/panier.liquid.
{% endcomment %}
<div class="panier-page verre">
  {% render 'panier-contenu', textes: section.settings %}
  {%- if additional_checkout_buttons and cart.item_count > 0 -%}
    <div class="panier__express">{{ content_for_additional_checkout_buttons }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .panier-page {
    max-width: 520px;
    margin: 120px auto 80px;
    border-radius: 22px;
    color: var(--ivoire);
  }

  @media (max-width: 600px) {
    .panier-page {
      margin: 88px 12px 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Panier (page)",
  "settings": [
    { "type": "text", "id": "titre", "label": "Titre", "default": "Ton panier" },
    { "type": "text", "id": "livraison_offerte", "label": "Message livraison atteinte", "default": "Livraison en point relais offerte" },
    { "type": "text", "id": "surtitre_arc", "label": "Surtitre du tome proposé", "default": "Termine l'arc" },
    { "type": "text", "id": "libelle_payer", "label": "Bouton de paiement", "default": "Payer" },
    { "type": "text", "id": "texte_vide", "label": "Panier vide : texte", "default": "Ton panier est vide." },
    { "type": "text", "id": "libelle_vide", "label": "Panier vide : bouton", "default": "Découvrir nos histoires" }
  ]
}
{% endschema %}
