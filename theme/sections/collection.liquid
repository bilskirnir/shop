{% comment %}
  Le catalogue (/collections/all) et toute page de collection : les livres rangés par histoire,
  de la plus ancienne à la plus récente (date de parution de son premier livre, custom.date_parution),
  avec ses années de parution à gauche. Une histoire sans date passe en dernier.
  Sur une autre collection que « all », seules les histoires dont un livre est dans la collection s'affichent.
  Maquette validée le 21/11/2026 : https://claude.ai/artifact/5WVfrNr4NNYeFgWHW7koaK
{% endcomment %}
{%- liquid
  # Chaque saga en « date du premier livre|handle », triées : l'ordre par ancienneté.
  assign cles = ''
  for saga in shop.metaobjects.saga.values
    assign premiere = '9999-12-31'
    for tome in saga.ordre_des_tomes.value
      assign d = tome.metafields.custom.date_parution.value | date: '%Y-%m-%d'
      if d != blank and d < premiere
        assign premiere = d
      endif
    endfor
    assign cles = cles | append: premiere | append: '|' | append: saga.system.handle | append: ','
  endfor
  assign cles = cles | split: ',' | sort

  assign tout = false
  if collection.handle == 'all'
    assign tout = true
  endif

  # Les produits de la collection, en « ,id,id, ».
  # shortcut: lit les 50 premiers produits de la collection, à paginer si le catalogue dépasse 50 livres.
  assign ids = collection.products | map: 'id' | join: ','
  assign ids = ',' | append: ids | append: ','
-%}
<section class="catalogue">
  <div class="catalogue__tete" data-reveal>
    <p class="surtitre">{{ section.settings.surtitre }}</p>
    <h1>{% if tout %}{{ section.settings.titre }}{% else %}{{ collection.title }}{% endif %}</h1>
    {%- if tout or collection.description == blank -%}
      <p class="catalogue__accroche">{{ section.settings.accroche }}</p>
    {%- else -%}
      <div class="catalogue__accroche">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- for cle_saga in cles -%}
    {%- liquid
      assign handle = cle_saga | split: '|' | last
      assign saga = shop.metaobjects.saga[handle]
      assign tomes = saga.ordre_des_tomes.value

      # Années de parution : « 2019 – 2023 », ou une seule année.
      assign annee_min = '9999'
      assign annee_max = ''
      for tome in tomes
        assign a = tome.metafields.custom.date_parution.value | date: '%Y'
        if a != blank
          if a < annee_min
            assign annee_min = a
          endif
          if a > annee_max
            assign annee_max = a
          endif
        endif
      endfor
      assign annees = ''
      if annee_max != blank
        assign annees = annee_min
        if annee_max != annee_min
          assign annees = annee_min | append: ' – ' | append: annee_max
        endif
      endif

      assign montrer = tout
      unless tout
        for tome in tomes
          assign cle = ',' | append: tome.id | append: ','
          if ids contains cle
            assign montrer = true
            break
          endif
        endfor
      endunless
    -%}
    {%- if montrer and tomes.size > 0 -%}
      <section class="catalogue__histoire" style="{% render 'saga-halo', saga: saga %}" data-reveal>
        <div class="catalogue__nom">
          {%- if annees != blank %}<p class="catalogue__annees">{{ annees }}</p>{% endif %}
          <p class="surtitre">{% render 'saga-surtitre', saga: saga %}</p>
          <h2>{{ saga.nom.value | default: saga.system.handle }}</h2>
          <a class="catalogue__lien" href="{% render 'saga-lien', saga: saga %}">
            {%- if tomes.size > 1 %}{{ section.settings.libelle_arc }}{% else %}{{ section.settings.libelle_livre }}{% endif %} <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="catalogue__livres">
          {%- for tome in tomes -%}
            <li>
              <a class="catalogue__livre" href="{{ tome.url }}">
                {%- if tome.featured_image -%}
                  {%- capture texte_alt %}Couverture : {% render 'livre-titre', livre: tome %}{% endcapture -%}
                  {{- tome.featured_image | image_url: width: 600 | image_tag: widths: '240, 360, 480, 600', sizes: '(min-width: 1024px) 220px, 45vw', alt: texte_alt, loading: 'lazy' -}}
                {%- endif -%}
                <strong>{% render 'livre-titre', livre: tome %}</strong>
                <span>
                  {%- if tomes.size > 1 %}Livre {{ forloop.index }} · {% endif -%}
                  {%- if tome.available %}{{ tome.price | money_without_trailing_zeros }}{% else %}À paraître{% endif -%}
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </section>
    {%- endif -%}
  {%- endfor -%}
</section>

{% stylesheet %}
  .catalogue {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 5vw, 56px);
    padding: clamp(110px, 12vw, 160px) var(--marge-centre) 96px;
  }

  .catalogue__tete {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .catalogue__tete .surtitre {
    color: var(--gris-2);
  }

  .catalogue__tete h1 {
    font-size: clamp(44px, 5vw, 72px);
    line-height: 0.95;
  }

  .catalogue__accroche {
    max-width: 640px;
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.5;
    color: var(--gris-1);
  }

  .catalogue__histoire {
    display: grid;
    gap: 18px;
    padding-top: clamp(28px, 3vw, 40px);
    border-top: 1px solid #ece5d61f;
  }

  .catalogue__nom {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .catalogue__annees {
    margin-bottom: 4px;
    font-family: var(--titre);
    font-size: clamp(20px, 2vw, 24px);
    font-variant-numeric: tabular-nums;
    color: var(--gris-2);
  }

  .catalogue__nom .surtitre,
  .catalogue__lien {
    color: var(--teinte, var(--gris-2));
  }

  .catalogue__nom h2 {
    font-size: clamp(30px, 3vw, 40px);
    line-height: 1.05;
  }

  .catalogue__lien {
    align-self: flex-start;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .catalogue__livres {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 16px;
    padding: 0;
    list-style: none;
  }

  .catalogue__livre {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
  }

  .catalogue__livre img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 3px;
    box-shadow: 0 18px 36px -12px #000000e6, 0 0 0 1px #ece5d614;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .catalogue__livre:hover img {
    transform: translateY(-4px);
  }

  .catalogue__livre strong {
    font-family: var(--titre);
    font-size: 17px;
    line-height: 1.2;
  }

  .catalogue__livre span {
    margin-top: -8px;
    font-size: 14px;
    color: var(--gris-2);
  }

  @media (min-width: 1024px) {
    .catalogue__histoire {
      grid-template-columns: 300px minmax(0, 1fr);
      gap: 48px;
    }

    .catalogue__lien {
      font-size: 16px;
    }

    .catalogue__livres {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 32px;
    }

    .catalogue__livre strong {
      font-size: 19px;
    }

    .catalogue__livre span {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .catalogue__livre img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Catalogue",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Le catalogue" },
    { "type": "text", "id": "titre", "label": "Titre (tous les livres)", "default": "Tous nos livres" },
    {
      "type": "text",
      "id": "accroche",
      "label": "Accroche",
      "default": "Rangés par histoire, de la plus ancienne à la plus récente."
    },
    { "type": "text", "id": "libelle_arc", "label": "Lien d'une saga", "default": "Découvrir l'arc" },
    { "type": "text", "id": "libelle_livre", "label": "Lien d'un livre seul", "default": "Découvrir le livre" }
  ]
}
{% endschema %}
