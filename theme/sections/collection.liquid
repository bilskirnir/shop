{% comment %}
  Le catalogue (/collections/all) et toute page de collection : les livres rangés par histoire,
  de la plus récente à la plus ancienne (date de parution de son premier livre, custom.date_parution),
  avec ses années de parution à gauche. Une histoire sans date passe en dernier.
  Sur une autre collection que « all », seules les histoires dont un livre est dans la collection s'affichent.
  En bas, le groupe « Bonus » : tous les produits rattachés à aucune saga (livrets d'écriture, demain des t-shirts…).
  Maquette validée le 21/11/2026 : https://claude.ai/artifact/5WVfrNr4NNYeFgWHW7koaK
{% endcomment %}
{%- liquid
  # Chaque saga en « date du premier livre|handle », triées puis inversées : la plus récente en haut.
  # Sans date, '0000-…' la fait passer en dernier.
  assign cles = ''
  # Les livres qui appartiennent à une saga, en « ,id,id, » : les autres vont dans le groupe Bonus.
  assign ids_sagas = ','
  for saga in shop.metaobjects.saga.values
    assign premiere = ''
    for tome in saga.ordre_des_tomes.value
      assign ids_sagas = ids_sagas | append: tome.id | append: ','
      assign d = tome.metafields.custom.date_parution.value | date: '%Y-%m-%d'
      if d != blank
        if premiere == blank or d < premiere
          assign premiere = d
        endif
      endif
    endfor
    assign premiere = premiere | default: '0000-00-00'
    assign cles = cles | append: premiere | append: '|' | append: saga.system.handle | append: ','
  endfor
  assign cles = cles | split: ',' | sort | reverse

  assign tout = false
  if collection.handle == 'all'
    assign tout = true
  endif

  # Les produits de la collection, en « ,id,id, ».
  # shortcut: lit les 50 premiers produits de la collection, à paginer si le catalogue dépasse 50 livres.
  assign ids = collection.products | map: 'id' | join: ','
  assign ids = ',' | append: ids | append: ','
-%}
<section class="catalogue">
  <div class="catalogue__tete" data-reveal>
    <p class="surtitre">{{ section.settings.surtitre }}</p>
    <h1>{% if tout %}{{ section.settings.titre }}{% else %}{{ collection.title }}{% endif %}</h1>
    {%- if tout or collection.description == blank -%}
      <p class="catalogue__accroche">{{ section.settings.accroche }}</p>
    {%- else -%}
      <div class="catalogue__accroche">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- for cle_saga in cles -%}
    {%- liquid
      assign handle = cle_saga | split: '|' | last
      assign saga = shop.metaobjects.saga[handle]
      assign tomes = saga.ordre_des_tomes.value

      # Années de parution : « 2019 – 2023 », ou une seule année.
      assign annee_min = '9999'
      assign annee_max = ''
      for tome in tomes
        assign a = tome.metafields.custom.date_parution.value | date: '%Y'
        if a != blank
          if a < annee_min
            assign annee_min = a
          endif
          if a > annee_max
            assign annee_max = a
          endif
        endif
      endfor
      assign annees = ''
      if annee_max != blank
        assign annees = annee_min
        if annee_max != annee_min
          assign annees = annee_min | append: ' – ' | append: annee_max
        endif
      endif

      assign montrer = tout
      unless tout
        for tome in tomes
          assign cle = ',' | append: tome.id | append: ','
          if ids contains cle
            assign montrer = true
            break
          endif
        endfor
      endunless
    -%}
    {%- if montrer and tomes.size > 0 -%}
      <section class="catalogue__histoire" style="{% render 'saga-halo', saga: saga %}" data-reveal>
        <div class="catalogue__nom">
          {%- if annees != blank %}<p class="catalogue__annees">{{ annees }}</p>{% endif %}
          <p class="surtitre">{% render 'saga-surtitre', saga: saga %}</p>
          <h2>{{ saga.nom.value | default: saga.system.handle }}</h2>
          <a class="catalogue__lien" href="{% render 'saga-lien', saga: saga %}">
            {%- if tomes.size > 1 %}{{ section.settings.libelle_arc }}{% else %}{{ section.settings.libelle_livre }}{% endif %} <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="livres-grille">
          {%- for tome in tomes -%}
            {%- assign mention = '' -%}
            {%- if tomes.size > 1 %}{% assign mention = 'Livre ' | append: forloop.index %}{% endif -%}
            <li>{% render 'livre-carte', livre: tome, mention: mention %}</li>
          {%- endfor -%}
        </ul>
      </section>
    {%- endif -%}
  {%- endfor -%}

  {%- capture bonus -%}
    {%- for produit in collection.products -%}
      {%- assign cle = ',' | append: produit.id | append: ',' -%}
      {%- unless ids_sagas contains cle -%}
        <li>{% render 'livre-carte', livre: produit %}</li>
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if bonus != blank -%}
    <section class="catalogue__histoire" data-reveal>
      <div class="catalogue__nom">
        <h2>{{ section.settings.bonus_titre }}</h2>
        {%- if section.settings.bonus_texte != blank %}<p class="catalogue__bonus-texte">{{ section.settings.bonus_texte }}</p>{% endif %}
      </div>
      <ul class="livres-grille">{{ bonus }}</ul>
    </section>
  {%- endif -%}
</section>

{% stylesheet %}
  .catalogue {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 5vw, 56px);
    padding: clamp(110px, 12vw, 160px) var(--marge-centre) 96px;
  }

  .catalogue__tete {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .catalogue__tete .surtitre {
    color: var(--gris-2);
  }

  .catalogue__tete h1 {
    font-size: clamp(44px, 5vw, 72px);
    line-height: 0.95;
  }

  .catalogue__accroche {
    max-width: 640px;
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.5;
    color: var(--gris-1);
  }

  .catalogue__histoire {
    display: grid;
    gap: 18px;
    padding-top: clamp(28px, 3vw, 40px);
    border-top: 1px solid #ece5d61f;
  }

  .catalogue__nom {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .catalogue__annees {
    margin-bottom: 4px;
    font-family: var(--titre);
    font-size: clamp(20px, 2vw, 24px);
    font-variant-numeric: tabular-nums;
    color: var(--gris-2);
  }

  .catalogue__nom .surtitre,
  .catalogue__lien {
    color: var(--teinte, var(--gris-2));
  }

  .catalogue__nom h2 {
    font-size: clamp(30px, 3vw, 40px);
    line-height: 1.05;
  }

  .catalogue__bonus-texte {
    max-width: 280px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--gris-1);
  }

  .catalogue__lien {
    align-self: flex-start;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .catalogue__histoire {
      grid-template-columns: 300px minmax(0, 1fr);
      gap: 48px;
    }

    .catalogue__lien {
      font-size: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Catalogue",
  "settings": [
    { "type": "text", "id": "surtitre", "label": "Surtitre", "default": "Le catalogue" },
    { "type": "text", "id": "titre", "label": "Titre (tous les produits)", "default": "Notre catalogue" },
    {
      "type": "text",
      "id": "accroche",
      "label": "Accroche",
      "default": "Rangés par histoire, de la plus récente à la plus ancienne."
    },
    { "type": "text", "id": "libelle_arc", "label": "Lien d'une saga", "default": "Découvrir l'arc" },
    { "type": "text", "id": "libelle_livre", "label": "Lien d'un livre seul", "default": "Découvrir le livre" },
    { "type": "header", "content": "Bonus (produits hors saga)" },
    { "type": "text", "id": "bonus_titre", "label": "Titre", "default": "Bonus" },
    { "type": "text", "id": "bonus_texte", "label": "Texte", "default": "Pour prolonger l'aventure." }
  ]
}
{% endschema %}
