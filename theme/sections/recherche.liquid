{% comment %}
  Le voile de recherche, sur toutes les pages (layout/theme.liquid) : la loupe de l'en-tête ou la touche « / »
  l'ouvrent, Échap ou un clic à côté le ferment. Avant de taper : les histoires et les dernières sorties.
  À chaque frappe, assets/recherche.js remplace [data-resultats] par sections/recherche-suggestions.liquid
  et pose la couleur de la saga trouvée sur le voile (le halo). Entrée mène à la page /search.
  Maquette validée le 22/11/2026 : https://claude.ai/artifact/PmSVcZfZVXsQwrKSrGhMKU
{% endcomment %}
<dialog class="recherche" id="recherche" aria-label="Recherche" data-suggestions="{{ routes.predictive_search_url }}">
  <div class="recherche__colonne">
    <div class="recherche__haut">
      <label class="recherche__etiquette" for="recherche-champ">{{ section.settings.etiquette }}</label>
      <button class="recherche__fermer" type="button" data-fermer aria-label="Fermer la recherche">
        <span class="recherche__touche" aria-hidden="true">Échap</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      <div class="recherche__cadre verre">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
        <input
        class="recherche__champ"
        id="recherche-champ"
        type="text"
        name="q"
        placeholder="{{ section.settings.indication }}"
        autocomplete="off"
        enterkeyhint="search"
        >
      </div>
      {%- comment -%} type="text" et non "search" : sur un champ search, le premier Échap vide le champ au lieu de fermer le voile. {%- endcomment -%}
    </form>

    <div data-accueil>
      <p class="suggestions__titre">Par où commencer ?</p>
      <div class="recherche__puces">
        {%- for saga in shop.metaobjects.saga.values -%}
          {%- if saga.ordre_des_tomes.value.size > 0 -%}
            <a class="recherche__puce" href="{% render 'saga-lien', saga: saga %}" style="{% render 'saga-halo', saga: saga %}">
              <span class="suggestions__pastille" aria-hidden="true"></span>
              {{- saga.nom.value -}}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <p class="suggestions__titre">Dernières sorties</p>
      <ul class="livres-grille recherche__recents">
        {%- comment -%} shortcut: « dernières sorties » = derniers livres mis en ligne, pas la date de parution ; à trier par custom.date_parution si l'écart gêne. {%- endcomment -%}
        {%- assign recents = collections.all.products | sort: 'published_at' | reverse -%}
        {%- for livre in recents limit: 6 -%}
          <li>{% render 'livre-carte', livre: livre %}</li>
        {%- endfor -%}
      </ul>
    </div>

    <div data-resultats aria-live="polite"></div>
  </div>

  <p class="recherche__raccourcis verre" aria-hidden="true">
    <span><span class="recherche__touche">↵</span> voir tous les livres</span>
    <span><span class="recherche__touche">/</span> ouvrir de partout</span>
    <span><span class="recherche__touche">Échap</span> fermer</span>
  </p>
</dialog>

{% stylesheet %}
  /* ---------- Le voile ---------- */
  .recherche {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: #0b0c0ee6;
    color: var(--ivoire);
    overflow-y: auto;
  }

  .recherche[open] {
    animation: recherche-fondu 0.35s ease;
  }

  .recherche::backdrop {
    background: #0b0c0e66;
    backdrop-filter: blur(14px) saturate(0.6);
    -webkit-backdrop-filter: blur(14px) saturate(0.6);
  }

  /* Le halo : la couleur de la saga trouvée (--halo-fort, posé par recherche.js), sinon un gris froid. */
  .recherche::before {
    content: '';
    position: fixed;
    top: -340px;
    left: 50%;
    width: min(1300px, 160vw);
    height: 720px;
    translate: -50% 0;
    border-radius: 50%;
    background-color: var(--halo-fort, #3a3f4a66);
    filter: blur(110px);
    transition: background-color 0.8s ease;
    pointer-events: none;
  }

  .recherche__colonne {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px var(--marge-centre) 120px;
  }

  .recherche__haut {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .recherche__etiquette,
  .suggestions__titre {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gris-2);
  }

  .recherche__fermer {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 44px;
    min-height: 44px;
    justify-content: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ivoire);
    cursor: pointer;
  }

  .recherche__touche {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 24px;
    padding: 0 7px;
    border-radius: 6px;
    border: 1px solid #ece5d633;
    font-size: 12px;
    font-weight: 700;
    color: var(--gris-1);
  }

  .recherche__fermer .recherche__touche {
    display: none;
  }

  /* Le grand champ encadré, en verre comme celui de la newsletter. */
  .recherche__cadre {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 76px;
    padding: 0 24px;
    border: 1px solid #ece5d626;
    border-radius: 22px;
    color: var(--gris-2);
    transition: border-color 0.25s;
  }

  .recherche__cadre:focus-within {
    border-color: var(--or);
    color: var(--or);
  }

  .recherche__champ {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
    outline: none;
    color: var(--ivoire);
    caret-color: var(--or);
    font-family: var(--titre);
    font-size: clamp(30px, 5vw, 64px);
    line-height: 1.1;
  }

  .recherche__champ::placeholder {
    color: #ece5d633;
  }

  [data-accueil]:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 12px;
  }

  .recherche__puces {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
  }

  .recherche__puce {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid #ece5d626;
    border-radius: 999px;
    background: #ece5d608;
    color: var(--ivoire);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .recherche__puce:hover {
    border-color: #ece5d659;
  }

  .recherche .recherche__recents {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  /* ---------- Les résultats (sections/recherche-suggestions.liquid) ---------- */
  .suggestions {
    display: grid;
    gap: 28px;
    padding-top: 12px;
  }

  .suggestions__histoires,
  .suggestions__livres {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .suggestions__livres {
    gap: 16px;
  }

  .suggestions__saga {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 60px;
    padding: 8px 0;
    border-bottom: 1px solid #ece5d614;
    color: var(--ivoire);
    text-decoration: none;
    transition: padding 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .suggestions__saga:hover {
    padding-left: 8px;
  }

  .suggestions__pastille {
    flex-shrink: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--teinte, var(--gris-2));
    box-shadow: 0 0 14px 2px var(--halo-fort, transparent);
  }

  .suggestions__nom {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .suggestions__nom strong {
    font-family: var(--titre);
    font-size: 22px;
    line-height: 1.1;
  }

  .suggestions__nom span {
    font-size: 13px;
    color: var(--gris-2);
  }

  .suggestions__fleche {
    color: var(--teinte, var(--gris-2));
    font-size: 18px;
  }

  /* Remet à plat le .highlight global de sections/hello-world.liquid (démo du Skeleton). */
  .recherche .highlight {
    display: inline;
    height: auto;
    padding: 0;
    border-radius: 0;
    background: none;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
    font-weight: inherit;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .suggestions__rien {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 16px;
  }

  .suggestions__rien p:first-child {
    font-family: var(--titre);
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.2;
    color: var(--gris-1);
  }

  .suggestions__rien p:last-child {
    color: var(--gris-2);
  }

  .suggestions__rien a {
    color: var(--ivoire);
    font-weight: 600;
  }

  /* Les couvertures montent l'une après l'autre. */
  .recherche .livres-grille li {
    animation: recherche-monte 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .recherche .livres-grille li:nth-child(2) { animation-delay: 70ms; }
  .recherche .livres-grille li:nth-child(3) { animation-delay: 140ms; }
  .recherche .livres-grille li:nth-child(4) { animation-delay: 210ms; }
  .recherche .livres-grille li:nth-child(5) { animation-delay: 280ms; }
  .recherche .livres-grille li:nth-child(6) { animation-delay: 350ms; }
  .recherche .livres-grille li:nth-child(7) { animation-delay: 420ms; }
  .recherche .livres-grille li:nth-child(8) { animation-delay: 490ms; }
  .recherche .livres-grille li:nth-child(9) { animation-delay: 560ms; }
  .recherche .livres-grille li:nth-child(10) { animation-delay: 630ms; }

  .recherche__raccourcis {
    display: none;
  }

  @keyframes recherche-fondu {
    from { opacity: 0; }
  }

  @keyframes recherche-monte {
    from { transform: translateY(28px) rotate(2deg); opacity: 0; }
  }

  @media (min-width: 1024px) {
    .recherche__colonne {
      gap: 18px;
      padding-top: 40px;
    }

    .recherche__fermer {
      padding: 0 4px 0 14px;
      color: var(--gris-2);
    }

    .recherche__fermer .recherche__touche {
      display: inline-flex;
    }

    .recherche__cadre {
      min-height: 112px;
      gap: 22px;
      padding: 0 36px;
      border-radius: 28px;
    }

    .recherche .recherche__recents {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .suggestions {
      grid-template-columns: 340px minmax(0, 1fr);
      gap: 64px;
    }

    .suggestions .livres-grille {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 26px;
    }

    .suggestions__nom strong {
      font-size: 24px;
    }

    .recherche__raccourcis {
      position: fixed;
      bottom: 28px;
      left: 50%;
      translate: -50% 0;
      display: flex;
      align-items: center;
      gap: 22px;
      min-height: 48px;
      padding: 0 22px;
      border-radius: 999px;
      font-size: 14px;
      color: var(--gris-2);
    }

    .recherche__raccourcis > span {
      display: flex;
      align-items: center;
      gap: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recherche[open],
    .recherche .livres-grille li {
      animation: none;
    }

    .recherche::before,
    .recherche__cadre,
    .suggestions__saga {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Voile de recherche",
  "settings": [
    { "type": "text", "id": "etiquette", "label": "Étiquette", "default": "Chercher une histoire, un livre" },
    { "type": "text", "id": "indication", "label": "Texte du champ vide", "default": "Que cherches-tu ?" }
  ]
}
{% endschema %}
