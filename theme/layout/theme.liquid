<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  class="page-{{ template.name }}{% if request.design_mode %} design-mode{% endif %}"
>
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Buenard:wght@400;700&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap"
    >

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
    <script src="{{ 'reveal.js' | asset_url }}" defer></script>
    {%- if template.name == 'index' %}
      <script src="{{ 'indicateur.js' | asset_url }}" defer></script>
    {%- endif %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% render 'decor' %}

    {% sections 'header-group' %}

    <main>
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
