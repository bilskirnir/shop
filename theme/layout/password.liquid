<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>

    {% # Load and preload the critical CSS %}
    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {%- if settings.favicon -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    {%- endif -%}
    {{ content_for_header }}
  </head>

  <body>
    {{ content_for_layout }}
  </body>
</html>
